; JavaScript code generation — enhanced emit-js macro
;
; Compiles Marlang S-expressions to JavaScript strings at macro expansion time.
; Supports: literals, lambda, let, if, begin, define, match, ADTs, operators,
; perform (→ yield), lambda* (→ generator function), call* (→ yield*),
; handle* (→ local effect driver), and recur (→ trampoline bounce).
;
; Usage:
;   (import "std:js" as js)
;   (js/emit-js (+ 1 2))              ; => "(1 + 2)"
;   (js/emit-js (perform print "hi")) ; => '(yield {effect:"print",args:["hi"]})'
;   (js/emit-js (lambda* (x) (perform atom-new x)))
;     ; => '(function*(x) { return (yield {effect:"atom_new",args:[x]}); })'
;
;   ; define-shared — dual emit: Marlang function + JS code
;   (js/define-shared double (x) (* x 2))
;   (double 21)       ; => 42  (Marlang)
;   (js/shared-js)    ; => "const double = ((x) => (x * 2));"
;
;   ; define-client — dual emit: Marlang handler + JS generator component
;   (js/define-client counter (initial)
;     (let ((count (perform atom-new initial)))
;       (string-append (show (perform atom-read count)) " clicks")))

(import "std:concurrent" as conc)

; =========================================================================
; Client effect declarations
;
; These enable standard (perform ...) syntax in define-client bodies,
; type-checked by the Marlang type checker. At runtime on the client,
; the JS runtime handles these effects (atom effects locally, unknown
; effects proxied to the server over WebSocket).
;
; Types are intentionally loose (a -> a) because atom refs are opaque
; IDs at the JS level. The type checker still verifies effect names,
; arities, and that effects are declared.
; =========================================================================

(effect Atom
  (atom-new  (-> a a))
  (atom-read (-> a a))
  (atom-set  (-> a a a))
  (atom-swap (-> a (-> a a) a)))

; =========================================================================
; emit-js macro — compiles a single Marlang expression to a JS string
; =========================================================================

(defmacro emit-js (body)
  ((lambda ()

    ; --- Identifier translation ---

    (define js-ident (lambda (name)
      (match name
        ("#t" "true") ("#f" "false") ("nil" "null")
        (_ (string-replace-all (string-replace-all name "-" "_") "?" "_p")))))

    ; --- Binary operator support ---

    (define js-op (lambda (op)
      (match op
        ("+" "+") ("-" "-") ("*" "*") ("/" "/") ("rem" "%")
        ("+." "+") ("-." "-") ("*." "*") ("/." "/") ("rem." "%")
        ("=" "===") ("<" "<") (">" ">") ("<=" "<=") (">=" ">=")
        ("=." "===") ("<." "<") (">." ">") ("<=." "<=") (">=." ">=")
        ("string=" "===") ("string-append" "+")
        ("and" "&&") ("or" "||")
        (_ op))))

    (define js-binop? (lambda (op)
      (match op
        ("+" #t) ("-" #t) ("*" #t) ("/" #t) ("rem" #t)
        ("+." #t) ("-." #t) ("*." #t) ("/." #t) ("rem." #t)
        ("=" #t) ("<" #t) (">" #t) ("<=" #t) (">=" #t)
        ("=." #t) ("<." #t) (">." #t) ("<=." #t) (">=." #t)
        ("string=" #t) ("string-append" #t)
        ("and" #t) ("or" #t)
        (_ #f))))

    ; --- Detect uppercase (ADT constructor names) ---

    (define upper? (lambda (s)
      (if (string-is-empty s) #f
        (match (string-char-at s 0)
          (None #f)
          ((Some c)
            (let ((code (char-code c)))
              (if (>= code 65) (<= code 90) #f)))))))

    ; --- Core expression compiler ---

    (define js-expr (lambda (e)
      (if (number? e) (show e)
      (if (string? e) (string-append "\"" (js-escape-string e) "\"")
      (if (symbol? e)
        (let ((name (symbol->string e)))
          (if (upper? name)
            ; Bare uppercase symbol = nullary ADT constructor
            (string-append "{tag:\"" name "\",fields:[]}")
            (js-ident name)))
      (if (nil? e) "null"
      (if (pair? e)
        (let ((head (car e)) (args (cdr e)))
          (if (symbol? head)
            (js-special (symbol->string head) args)
            ; Function call with computed function
            (string-append (js-expr head) "(" (js-args args) ")")))
      "/* ?? */")))))))

    ; --- String escaping for JS string literals ---

    (define js-escape-string (lambda (s)
      (string-replace-all
        (string-replace-all
          (string-replace-all s "\\" "\\\\")
          "\"" "\\\"")
        "\n" "\\n")))

    ; --- Special forms ---

    (define js-special (lambda (name args)
      (match name
        ; --- Lambda (regular arrow function) ---
        ("lambda"
          (let ((params (car args))
                (body (car (cdr args))))
            (if (nil? params)
              ; Zero-arg lambda: () => body
              (string-append "(() => " (js-expr body) ")")
              (string-append "((" (js-params params) ") => " (js-expr body) ")"))))

        ; --- Lambda* (generator function) ---
        ; Uses statement-based body compilation to avoid IIFE problems with yield.
        ("lambda*"
          (let ((params (car args))
                (body (car (cdr args))))
            (if (nil? params)
              (string-append "(function*() { " (js-gen-body body) "})")
              (string-append "(function*(" (js-params params) ") { " (js-gen-body body) "})"))))

        ; --- Let binding ---
        ("let"
          (string-append "(() => { " (js-binds (car args)) "return " (js-expr (car (cdr args))) "; })()"))

        ; --- Conditionals ---
        ("if"
          (string-append "(" (js-expr (car args)) " ? " (js-expr (car (cdr args))) " : " (js-expr (car (cdr (cdr args)))) ")"))

        ("when"
          (string-append "(" (js-expr (car args)) " ? " (js-expr (car (cdr args))) " : null)"))

        ; --- Sequencing ---
        ("begin" (js-begin args))

        ; --- Definitions ---
        ("define"
          (string-append "const " (js-ident (symbol->string (car args))) " = " (js-expr (car (cdr args)))))

        ; --- Data structures ---
        ("list" (string-append "[" (js-args args) "]"))
        ("MkPair" (string-append "[" (js-expr (car args)) ", " (js-expr (car (cdr args))) "]"))

        ; --- Show (toString) ---
        ("show" (string-append "String(" (js-expr (car args)) ")"))

        ; --- Not ---
        ("not" (string-append "(!" (js-expr (car args)) ")"))

        ; --- Pattern matching ---
        ("match"
          (string-append "(() => { const __m = " (js-expr (car args)) "; " (js-branches (cdr args)) "throw new Error('no match'); })()"))

        ; --- Option constructors (special-cased for null representation) ---
        ("Some" (string-append "{tag:\"Some\",fields:[" (js-expr (car args)) "]}" ))
        ("None" "{tag:\"None\",fields:[]}")

        ; --- Perform (effect operation → generator yield) ---
        ("perform"
          (let ((op-name (js-ident (symbol->string (car args))))
                (op-args (cdr args)))
            (string-append "(yield {effect:\"" op-name "\",args:[" (js-args op-args) "]})")))

        ; --- Call* (delegate to another generator via yield*) ---
        ("call*"
          (let ((call-expr (car args)))
            (if (pair? call-expr)
              (let ((fn (car call-expr))
                    (fn-args (cdr call-expr)))
                (if (symbol? fn)
                  (string-append "(yield* " (js-ident (symbol->string fn)) "(" (js-args fn-args) "))")
                  (string-append "(yield* " (js-expr fn) "(" (js-args fn-args) "))")))
              (string-append "(yield* " (js-expr call-expr) ")"))))

        ; --- Recur (trampoline tail call) ---
        ; (recur (f arg1 arg2)) → marlang.bounce(() => f(arg1, arg2))
        ; Used inside functions wrapped with marlang.trampoline() for TCO.
        ("recur"
          (let ((call-expr (car args)))
            (if (pair? call-expr)
              (let ((fn (car call-expr))
                    (fn-args (cdr call-expr)))
                (if (symbol? fn)
                  (string-append "marlang.bounce(() => " (js-ident (symbol->string fn)) "(" (js-args fn-args) "))")
                  (string-append "marlang.bounce(() => " (js-expr fn) "(" (js-args fn-args) "))")))
              (string-append "marlang.bounce(() => " (js-expr call-expr) ")"))))

        ; --- Handle* (local effect handling — generator driver) ---
        ; (handle* gen-expr ((effect-name arg1 arg2 ...) -> resume-value-expr) ...)
        ; Handlers don't take a continuation — they just evaluate to the resume value.
        ; Unhandled effects are re-yielded to the outer generator (must be in lambda* context).
        ("handle*"
          (let ((gen-expr (car args))
                (clauses (cdr args)))
            (string-append
              "(yield* (function*() { const __gen = " (js-expr gen-expr)
              "; let __r = __gen.next(); while (!__r.done) { const __e = __r.value; let __v; "
              (js-handle-clauses clauses)
              " else { __v = yield __e; } __r = __gen.next(__v); } return __r.value; })())")))

        ; --- Default: function call or ADT constructor ---
        (_
          (if (upper? name)
            ; ADT constructor: (Foo a b c) → {tag:"Foo",fields:[a,b,c]}
            (string-append "{tag:\"" name "\",fields:[" (js-args args) "]}")
            (if (js-binop? name)
              (string-append "(" (js-expr (car args)) " " (js-op name) " " (js-expr (car (cdr args))) ")")
              (string-append (js-ident name) "(" (js-args args) ")")))))))

    ; --- Handle* clause compilation ---

    (define js-handle-clauses (lambda (clauses)
      (if (nil? clauses) ""
        (let ((clause (car clauses))
              (rest (cdr clauses)))
          (string-append (js-one-handle-clause clause)
            (if (nil? rest) ""
              (string-append " else " (js-handle-clauses rest))))))))

    (define js-one-handle-clause (lambda (clause)
      ; clause is ((effect-name arg1 arg2 ...) -> handler-body)
      ; or ((effect-name arg1 arg2 ...) handler-body) without ->
      ; Handler body evaluates to the resume value (no explicit continuation).
      (let ((pattern (car clause))
            (rest-after-pattern (cdr clause)))
        ; Skip the -> arrow if present
        (let ((handler-body
                (if (pair? rest-after-pattern)
                  (let ((maybe-arrow (car rest-after-pattern)))
                    (if (symbol? maybe-arrow)
                      (if (string= (symbol->string maybe-arrow) "->")
                        (car (cdr rest-after-pattern))
                        (car rest-after-pattern))
                      (car rest-after-pattern)))
                  (car rest-after-pattern))))
          ; pattern is (effect-name arg1 arg2 ...)
          (let ((effect-name (symbol->string (car pattern)))
                (param-vars (cdr pattern)))
            (string-append
              "if (__e.effect === \"" (js-ident effect-name) "\") { "
              (js-destructure-args param-vars 0)
              "__v = " (js-expr handler-body) "; }"))))))

    ; Destructure effect args: const arg0 = __e.args[0]; const arg1 = __e.args[1]; ...
    (define js-destructure-args (lambda (vars idx)
      (if (nil? vars) ""
        (string-append "const " (js-ident (symbol->string (car vars)))
          " = __e.args[" (show idx) "]; "
          (js-destructure-args (cdr vars) (+ idx 1))))))

    ; --- Generator body compilation ---
    ; Compiles expressions as statements for use inside function* bodies.
    ; Flattens let bindings into const declarations and begin into sequential
    ; statements, so that yield works correctly (no IIFE wrapping).

    (define js-gen-body (lambda (e)
      (if (pair? e)
        (let ((head (car e)))
          (if (symbol? head)
            (let ((name (symbol->string head)))
              (match name
                ; Flatten let: const x = ...; const y = ...; <body>
                ("let"
                  (let ((bindings (car (cdr e)))
                        (body (car (cdr (cdr e)))))
                    (string-append (js-gen-binds bindings) (js-gen-body body))))
                ; Flatten begin: stmt; stmt; ...; return last;
                ("begin" (js-gen-stmts (cdr e)))
                ; Flatten if: if (cond) { ... } else { ... }
                ("if"
                  (let ((cond-e (car (cdr e)))
                        (then-e (car (cdr (cdr e))))
                        (else-e (car (cdr (cdr (cdr e))))))
                    (string-append "if (" (js-expr cond-e) ") { "
                      (js-gen-body then-e) "} else { "
                      (js-gen-body else-e) "} ")))
                ; Flatten match: rewrite as if/else chain in statement form
                ("match"
                  (string-append "const __m = " (js-expr (car (cdr e))) "; "
                    (js-gen-match-branches (cdr (cdr e)))))
                ; Flatten define: const name = expr;
                ("define"
                  (string-append "const " (js-ident (symbol->string (car (cdr e)))) " = "
                    (js-expr (car (cdr (cdr e)))) "; "))
                ; Anything else: return as expression
                (_ (string-append "return " (js-expr e) "; "))))
            (string-append "return " (js-expr e) "; ")))
        (string-append "return " (js-expr e) "; "))))

    ; Compile let bindings as const declarations for generator bodies.
    ; Each binding's value is compiled as a regular expression (supports yield).
    (define js-gen-binds (lambda (bindings)
      (if (nil? bindings) ""
        (let ((b (car bindings)))
          (string-append "const " (js-ident (symbol->string (car b)))
            " = " (js-expr (car (cdr b))) "; "
            (js-gen-binds (cdr bindings)))))))

    ; Compile an expression as a void statement (no return).
    ; Handles if/let/begin/match in statement form, just like js-gen-body
    ; but without the implicit return on the final expression.
    (define js-gen-void (lambda (e)
      (if (pair? e)
        (let ((head (car e)))
          (if (symbol? head)
            (let ((name (symbol->string head)))
              (match name
                ("let"
                  (let ((bindings (car (cdr e)))
                        (body (car (cdr (cdr e)))))
                    (string-append (js-gen-binds bindings) (js-gen-void body))))
                ("begin" (js-gen-void-stmts (cdr e)))
                ("if"
                  (let ((cond-e (car (cdr e)))
                        (then-e (car (cdr (cdr e))))
                        (else-e (car (cdr (cdr (cdr e))))))
                    (string-append "if (" (js-expr cond-e) ") { "
                      (js-gen-void then-e) "} else { "
                      (js-gen-void else-e) "} ")))
                (_ (string-append (js-expr e) "; "))))
            (string-append (js-expr e) "; ")))
        (string-append (js-expr e) "; "))))

    ; All statements as void (no return on any).
    (define js-gen-void-stmts (lambda (stmts)
      (if (nil? (cdr stmts))
        (js-gen-void (car stmts))
        (string-append (js-gen-void (car stmts)) (js-gen-void-stmts (cdr stmts))))))

    ; Compile a begin sequence as statements for generator bodies.
    ; All but the last are compiled as void statements; last gets return.
    (define js-gen-stmts (lambda (stmts)
      (if (nil? (cdr stmts))
        (js-gen-body (car stmts))
        (string-append (js-gen-void (car stmts)) (js-gen-stmts (cdr stmts))))))

    ; Compile match branches in statement form for generator bodies.
    (define js-gen-match-branches (lambda (branches)
      (if (nil? branches) "throw new Error('no match'); "
        (let ((br (car branches)))
          (string-append (js-gen-one-match (car br) (car (cdr br))) " "
            (js-gen-match-branches (cdr branches)))))))

    (define js-gen-one-match (lambda (pattern body)
      (if (symbol? pattern)
        (let ((name (symbol->string pattern)))
          (match name
            ("_" (js-gen-body body))
            ("None"
              (string-append "if (__m === null || (__m && __m.tag === \"None\")) { "
                (js-gen-body body) "}"))
            (_
              (if (upper? name)
                (string-append "if (__m && __m.tag === \"" name "\") { "
                  (js-gen-body body) "}")
                (string-append "{ const " (js-ident name) " = __m; "
                  (js-gen-body body) "}")))))
        (let ((tag (symbol->string (car pattern))))
          (string-append "if (__m && __m.tag === \"" tag "\") { "
            (js-destr (cdr pattern) 0)
            (js-gen-body body) "}")))))

    ; --- Begin (sequencing, expression mode) ---

    (define js-begin (lambda (args)
      (if (nil? (cdr args)) (js-expr (car args))
        (string-append "(" (js-expr (car args)) ", " (js-begin (cdr args)) ")"))))

    ; --- Parameter list ---

    (define js-params (lambda (ps)
      (if (nil? ps) ""
      (if (nil? (cdr ps)) (js-ident (symbol->string (car ps)))
        (string-append (js-ident (symbol->string (car ps))) ", " (js-params (cdr ps)))))))

    ; --- Argument list ---

    (define js-args (lambda (args)
      (if (nil? args) ""
      (if (nil? (cdr args)) (js-expr (car args))
        (string-append (js-expr (car args)) ", " (js-args (cdr args)))))))

    ; --- Let bindings ---

    (define js-binds (lambda (bindings)
      (if (nil? bindings) ""
        (let ((b (car bindings)))
          (string-append "const " (js-ident (symbol->string (car b)))
            " = " (js-expr (car (cdr b))) "; "
            (js-binds (cdr bindings)))))))

    ; --- Match branches ---

    (define js-branches (lambda (branches)
      (if (nil? branches) ""
        (let ((br (car branches)))
          (string-append (js-one-branch (car br) (car (cdr br))) " "
            (js-branches (cdr branches)))))))

    (define js-one-branch (lambda (pattern b)
      (if (symbol? pattern)
        (let ((name (symbol->string pattern)))
          (match name
            ("_"    (string-append "return " (js-expr b) ";"))
            ("None" (string-append "if (__m === null || (__m && __m.tag === \"None\")) { return " (js-expr b) "; }"))
            (_
              (if (upper? name)
                (string-append "if (__m && __m.tag === \"" name "\") { return " (js-expr b) "; }")
                ; Variable binding (lowercase) — binds the whole match value
                (string-append "{ const " (js-ident name) " = __m; return " (js-expr b) "; }")))))
        ; Destructuring pattern: (Tag arg1 arg2 ...)
        (let ((tag (symbol->string (car pattern))))
          (string-append "if (__m && __m.tag === \"" tag "\") { "
            (js-destr (cdr pattern) 0)
            "return " (js-expr b) "; }")))))

    (define js-destr (lambda (vars idx)
      (if (nil? vars) ""
        (string-append "const " (js-ident (symbol->string (car vars)))
          " = __m.fields[" (show idx) "]; "
          (js-destr (cdr vars) (+ idx 1))))))

    ; --- Entry point ---

    (js-expr body))))

; =========================================================================
; emit-js-block — compile multiple top-level forms to JS statements
; =========================================================================

(defmacro emit-js-block forms
  ((lambda ()

    ; Reuse emit-js for single expressions (by re-expanding)
    (define compile-one (lambda (form)
      (list 'emit-js form)))

    ; Join multiple compiled forms with ";\n"
    (define compile-all (lambda (fs)
      (if (nil? fs) "\"\""
      (if (nil? (cdr fs)) (compile-one (car fs))
        (list 'string-append (compile-one (car fs))
          (list 'string-append "\";\n\""
            (compile-all (cdr fs))))))))

    (compile-all forms))))

; =========================================================================
; Client-side effect runtime (JS source as Marlang string)
;
; Provides:
;   marlang.run(gen, handlers)  — drive a generator, handle effects
;   marlang.mount(el, genFn, args, handlers, ws)  — mount a component
;   marlang.connect(url)  — establish WebSocket for effect proxying
;
; Local effect handlers are objects: { effectName: (args, resume) => ... }
; Unhandled effects are proxied to the server over WebSocket.
; =========================================================================

(define client-runtime "
const marlang = (() => {
  let _nextId = 1;
  const _pending = new Map();
  let _ws = null;
  let _handlers = {};

  // ---- Trampoline for tail-call optimization ----
  // Functions compiled with (recur ...) return Bounce thunks.
  // trampoline() steps until a non-thunk value is reached.
  class Bounce { constructor(fn) { this.fn = fn; } }
  function trampoline(val) {
    while (val instanceof Bounce) val = val.fn();
    return val;
  }
  function bounce(fn) { return new Bounce(fn); }

  // ---- Generator driver ----
  // Drive a generator to completion, handling effects locally or via proxy.
  // handlers: { effectName: (args, resume) => void }
  //   - resume(value) continues the generator with the given value
  //   - If handler doesn't call resume synchronously, the generator pauses
  // Returns a Promise that resolves with the generator's return value.
  // _run is a mutable ref — overridden by runWithFeatures later.
  let _run;
  function run(gen, handlers) {
    const h = handlers || _handlers;
    return new Promise((resolve, reject) => {
      function step(value) {
        try {
          const result = gen.next(value);
          if (result.done) { resolve(result.value); return; }
          const eff = result.value;
          if (!eff || !eff.effect) {
            reject(new Error('Generator yielded non-effect: ' + JSON.stringify(eff)));
            return;
          }
          // Check local handlers first
          if (h[eff.effect]) {
            h[eff.effect](eff.args, step);
          } else if (_ws && _ws.readyState === 1) {
            // Proxy to server
            const id = _nextId++;
            _pending.set(id, { resolve: step, reject });
            _ws.send(JSON.stringify({ type: 'effect', id, effect: eff.effect, args: eff.args }));
          } else {
            reject(new Error('Unhandled effect: ' + eff.effect + ' (no local handler, no WebSocket)'));
          }
        } catch (e) { reject(e); }
      }
      step(undefined);
    });
  }

  // Handle incoming WebSocket messages (effect responses + morphdom updates)
  function handleMessage(data) {
    try {
      const msg = JSON.parse(data);
      if (msg.type === 'result' && _pending.has(msg.id)) {
        const { resolve } = _pending.get(msg.id);
        _pending.delete(msg.id);
        resolve(msg.value);
      } else if (msg.type === 'error' && _pending.has(msg.id)) {
        const { reject } = _pending.get(msg.id);
        _pending.delete(msg.id);
        reject(new Error(msg.message));
      }
    } catch (e) {
      // Not JSON — might be a morphdom/nav update from the live framework
    }
  }

  // Connect WebSocket for effect proxying + live updates.
  // Returns a Promise that resolves when the connection is open.
  let _connectPromise = null;
  function connect(url) {
    if (_connectPromise) return _connectPromise;
    _connectPromise = new Promise((resolve) => {
      _ws = new WebSocket(url || ('ws://' + location.host + '/'));
      _ws.onopen = () => resolve(_ws);
      _ws.onmessage = (e) => handleMessage(e.data);
      _ws.onclose = () => {
        _connectPromise = null;
        setTimeout(() => connect(url), 1000);
      };
    });
    return _connectPromise;
  }

  // Connect WebSocket, then mount a component.
  function connectAndMount(el, genFn, args) {
    connect().then(() => mount(el, genFn, args));
  }

  // ---- Mounting & reactive re-rendering ----
  const _mounts = [];

  // Mount a generator component into a DOM element.
  // Uses a hooks pattern: atom_new creates atoms on first render,
  // reuses them on subsequent re-renders (like React hooks).
  function mount(el, genFn, args, handlers) {
    const m = { el, genFn, args: args || [], hooks: [], hookIndex: 0 };

    function render() {
      m.hookIndex = 0;
      const gen = m.genFn.apply(null, m.args);
      return _run(gen, Object.assign({}, handlers || builtinHandlers, {
        atom_new(effArgs, resume) {
          const idx = m.hookIndex++;
          if (idx < m.hooks.length) {
            // Re-render: reuse existing atom
            resume(m.hooks[idx]);
          } else {
            // First render: create new atom
            const id = ++atomId;
            atoms.set(id, { value: effArgs[0] });
            m.hooks.push(id);
            resume(id);
          }
        }
      })).then(html => {
        if (typeof html === 'string') {
          if (typeof morphdom !== 'undefined') {
            const wrapper = document.createElement('div');
            wrapper.innerHTML = html;
            const newEl = wrapper.firstElementChild;
            if (newEl && el.firstElementChild) {
              morphdom(el.firstElementChild, newEl);
            } else {
              el.innerHTML = html;
            }
          } else {
            el.innerHTML = html;
          }
        }
        return html;
      });
    }

    m.render = render;
    _mounts.push(m);
    return render();
  }

  // Update an atom and re-render all mounted components.
  // Called from onclick handlers embedded in component HTML.
  function updateAtom(ref, fn) {
    const atom = atoms.get(ref);
    if (atom) atom.value = fn(atom.value);
    _mounts.forEach(m => m.render());
  }

  // Run a one-off generator action (e.g. from a button click).
  // Handles local effects + proxies unknown effects to the server.
  // Re-renders all mounted components when done.
  function action(genFn) {
    const gen = typeof genFn === 'function' ? genFn() : genFn;
    return _run(gen, builtinHandlers).then(() => {
      _mounts.forEach(m => m.render());
    }).catch(e => console.error('action error:', e));
  }

  // Register global handlers (merged into all run() calls)
  function registerHandlers(h) {
    Object.assign(_handlers, h);
  }

  // ---- Built-in local effect handlers ----

  // -- Atom: reactive state cell --
  const atoms = new Map();
  let atomId = 0;
  const atomHandlers = {
    atom_new(args, resume) {
      const id = ++atomId;
      atoms.set(id, { value: args[0] });
      resume(id);
    },
    atom_read(args, resume) {
      resume(atoms.get(args[0]).value);
    },
    atom_swap(args, resume) {
      const ref = args[0], fn = args[1];
      const atom = atoms.get(ref);
      atom.value = fn(atom.value);
      resume(atom.value);
    },
    atom_set(args, resume) {
      const atom = atoms.get(args[0]);
      atom.value = args[1];
      resume(args[1]);
    },
    parse_int(args, resume) {
      resume(parseInt(args[0], 10) || 0);
    }
  };

  // -- Dom: DOM manipulation --
  const domHandlers = {
    dom_set_html(args, resume) {
      const el = document.getElementById(args[0]);
      if (el) el.innerHTML = args[1];
      resume(null);
    },
    dom_get_value(args, resume) {
      const el = document.getElementById(args[0]);
      resume(el ? el.value : '');
    },
    dom_set_attr(args, resume) {
      const el = document.getElementById(args[0]);
      if (el) el.setAttribute(args[1], args[2]);
      resume(null);
    },
    dom_add_class(args, resume) {
      const el = document.getElementById(args[0]);
      if (el) el.classList.add(args[1]);
      resume(null);
    },
    dom_remove_class(args, resume) {
      const el = document.getElementById(args[0]);
      if (el) el.classList.remove(args[1]);
      resume(null);
    },
    dom_morph(args, resume) {
      const target = document.getElementById(args[0]);
      if (target && typeof morphdom !== 'undefined') {
        const tmp = document.createElement('div');
        tmp.innerHTML = args[1];
        morphdom(target, tmp.firstElementChild || tmp);
      }
      resume(null);
    }
  };

  // -- Timer: timeouts and intervals --
  const timerHandlers = {
    timer_delay(args, resume) {
      setTimeout(() => resume(null), args[0]);
    },
    timer_interval(args, resume) {
      const id = setInterval(() => args[1](null), args[0]);
      resume(id);
    },
    timer_clear(args, resume) {
      clearInterval(args[0]);
      resume(null);
    }
  };

  // -- Event: DOM event listeners --
  const eventHandlers = {
    event_listen(args, resume) {
      const el = args[0] === 'document' ? document
               : args[0] === 'window' ? window
               : document.getElementById(args[0]);
      if (el) el.addEventListener(args[1], args[2]);
      resume(null);
    },
    event_unlisten(args, resume) {
      const el = args[0] === 'document' ? document
               : args[0] === 'window' ? window
               : document.getElementById(args[0]);
      if (el) el.removeEventListener(args[1], args[2]);
      resume(null);
    },
    event_delegate(args, resume) {
      // args: [parentId, selector, eventType, callback]
      const parent = args[0] === 'document' ? document
                   : document.getElementById(args[0]);
      if (parent) {
        parent.addEventListener(args[2], (e) => {
          if (e.target.matches(args[1]) || e.target.closest(args[1])) {
            args[3](e);
          }
        });
      }
      resume(null);
    }
  };

  // All built-in handlers combined
  const builtinHandlers = Object.assign({},
    atomHandlers, domHandlers, timerHandlers, eventHandlers);

  // Merge user handlers with all built-in handlers
  function withBuiltins(userHandlers) {
    return Object.assign({}, builtinHandlers, userHandlers || {});
  }

  // ---- Effect allowlists ----
  // When a guarded component is mounted, its allowlist and HMAC token
  // are stored. Effect proxy messages include the allowlist and token
  // so the server can validate before dispatching.

  let _allowedEffects = null;  // Array of allowed effect names
  let _allowToken = null;      // HMAC hex string

  // Mount a guarded component with an effect allowlist.
  // allowlist: Array of effect name strings
  // token: HMAC-signed hex string from the server
  function connectAndMountGuarded(el, genFn, args, allowlist, token) {
    _allowedEffects = allowlist;
    _allowToken = token;
    connect().then(() => mount(el, genFn, args));
  }

  // ---- Prefetch cache ----
  // Pre-computed effect results inlined in the page by the server.
  // Checked before proxying an effect to the server. One-time use.

  function checkPrefetch(effectName, args) {
    if (!window.__prefetch) return undefined;
    // Try exact key: effect_name:arg1,arg2,...
    const key = effectName + ':' + (args || []).join(',');
    if (key in window.__prefetch) {
      const val = window.__prefetch[key];
      delete window.__prefetch[key];
      return val;
    }
    // Try effect name only (no args key)
    if (effectName in window.__prefetch) {
      const val = window.__prefetch[effectName];
      delete window.__prefetch[effectName];
      return val;
    }
    return undefined;
  }

  // ---- Batching ----
  // Send multiple effects in a single WebSocket message.
  // Returns a Promise that resolves with an array of results.

  function batchEffects(effects) {
    // effects: Array of {effect, args}
    return new Promise((resolve, reject) => {
      if (!_ws || _ws.readyState !== 1) {
        reject(new Error('No WebSocket connection for batch'));
        return;
      }
      const id = _nextId++;
      _pending.set(id, {
        resolve: (results) => resolve(results),
        reject
      });
      const msg = {
        type: 'batch',
        id,
        effects: effects.map(e => ({ effect: e.effect, args: e.args }))
      };
      _ws.send(JSON.stringify(msg));
    });
  }

  // Override the run function to support prefetch + allowlists + batch results
  function runWithFeatures(gen, handlers) {
    const h = handlers || _handlers;
    return new Promise((resolve, reject) => {
      function step(value) {
        try {
          const result = gen.next(value);
          if (result.done) { resolve(result.value); return; }
          const eff = result.value;
          if (!eff || !eff.effect) {
            reject(new Error('Generator yielded non-effect: ' + JSON.stringify(eff)));
            return;
          }
          // Check local handlers first
          if (h[eff.effect]) {
            h[eff.effect](eff.args, step);
            return;
          }
          // Check prefetch cache
          const prefetched = checkPrefetch(eff.effect, eff.args);
          if (prefetched !== undefined) {
            step(prefetched);
            return;
          }
          // Proxy to server
          if (_ws && _ws.readyState === 1) {
            const id = _nextId++;
            _pending.set(id, { resolve: step, reject });
            const msg = { type: 'effect', id, effect: eff.effect, args: eff.args };
            // Include allowlist if this is a guarded component
            if (_allowedEffects) {
              msg.allow = _allowedEffects;
              msg.token = _allowToken;
            }
            _ws.send(JSON.stringify(msg));
          } else {
            reject(new Error('Unhandled effect: ' + eff.effect + ' (no local handler, no WebSocket)'));
          }
        } catch (e) { reject(e); }
      }
      step(undefined);
    });
  }

  // Handle incoming WebSocket messages — now also handles batch results
  function handleMessageV2(data) {
    try {
      const msg = JSON.parse(data);
      if (msg.type === 'result' && _pending.has(msg.id)) {
        const { resolve } = _pending.get(msg.id);
        _pending.delete(msg.id);
        resolve(msg.value);
      } else if (msg.type === 'error' && _pending.has(msg.id)) {
        const { reject } = _pending.get(msg.id);
        _pending.delete(msg.id);
        reject(new Error(msg.message));
      } else if (msg.type === 'batch_result' && _pending.has(msg.id)) {
        const { resolve } = _pending.get(msg.id);
        _pending.delete(msg.id);
        // Extract values from results array, map errors to nulls
        const values = (msg.results || []).map(r =>
          r.error !== undefined ? null : r.value);
        resolve(values);
      }
    } catch (e) {
      // Not JSON — might be a morphdom/nav update from the live framework
    }
  }

  // Set _run to the feature-enhanced version so mount/action use it.
  _run = runWithFeatures;

  // Reconnect logic using the v2 message handler
  let _connectPromiseV2 = null;
  function connectV2(url) {
    if (_connectPromiseV2) return _connectPromiseV2;
    _connectPromiseV2 = new Promise((resolve) => {
      _ws = new WebSocket(url || ('ws://' + location.host + '/'));
      _ws.onopen = () => resolve(_ws);
      _ws.onmessage = (e) => handleMessageV2(e.data);
      _ws.onclose = () => {
        _connectPromiseV2 = null;
        _connectPromise = null;
        setTimeout(() => connectV2(url), 1000);
      };
    });
    _connectPromise = _connectPromiseV2;
    return _connectPromiseV2;
  }

  return {
    run: runWithFeatures, connect: connectV2,
    connectAndMount(el, genFn, args) {
      connectV2().then(() => mount(el, genFn, args));
    },
    connectAndMountGuarded,
    mount, updateAtom, action,
    handleMessage: handleMessageV2, registerHandlers,
    withBuiltins, builtinHandlers,
    atomHandlers, domHandlers, timerHandlers, eventHandlers,
    trampoline, bounce, Bounce,
    batchEffects, checkPrefetch
  };
})();
")

; =========================================================================
; Helper: wrap client JS in a <script> tag
; =========================================================================

(define runtime-script (lambda ()
  (string-append "<script>" client-runtime "</script>")))

; =========================================================================
; JS fragment registry — collects JS code from define-shared / define-client
;
; Uses a channel as a mutable box (single-element buffered channel).
; =========================================================================

(define __js-store-ch (conc/chan-new 1))
(conc/chan-send! __js-store-ch (MkPair (list) (list)))
; Store is a Pair: (shared-fragments, client-fragments)

(define __js-store-get (lambda ()
  (match (conc/chan-recv __js-store-ch)
    ((Some v) (begin (conc/chan-send! __js-store-ch v) v))
    (None (MkPair (list) (list))))))

(define __js-store-update (lambda (f)
  (match (conc/chan-recv __js-store-ch)
    ((Some v) (let ((new-val (f v))) (begin (conc/chan-send! __js-store-ch new-val) new-val)))
    (None nil))))

; register-shared-js : (-> String Unit) — push a shared JS fragment
(define register-shared-js (lambda (js-code)
  (__js-store-update (lambda (store)
    (match store
      ((MkPair shared client)
        (MkPair (append shared (list js-code)) client)))))))

; register-client-js : (-> String Unit) — push a client component JS fragment
(define register-client-js (lambda (js-code)
  (__js-store-update (lambda (store)
    (match store
      ((MkPair shared client)
        (MkPair shared (append client (list js-code)))))))))

(define __join-newlines (lambda (lst)
  (match lst
    (Nil "")
    ((Cons h Nil) h)
    ((Cons h rest) (string-append h ";\n" (__join-newlines rest))))))

; shared-js : (-> String) — all shared JS fragments joined with newlines
(define shared-js (lambda ()
  (match (__js-store-get)
    ((MkPair shared _) (__join-newlines shared)))))

; client-js : (-> String) — all client component JS fragments joined with newlines
(define client-js (lambda ()
  (match (__js-store-get)
    ((MkPair _ client) (__join-newlines client)))))

; client-bundle : (-> String) — complete JS bundle: runtime + shared + client code
(define client-bundle (lambda ()
  (string-append client-runtime "\n"
    (string-append (shared-js) "\n"
      (client-js)))))

; client-bundle-script : (-> String) — client-bundle wrapped in <script> tag
(define client-bundle-script (lambda ()
  (string-append "<script>\n" (client-bundle) "\n</script>")))

; =========================================================================
; Runtime helpers for serializing Marlang values to JS
; =========================================================================

; Convert a Marlang value to a JS literal string (for embedding in scripts).
; Uses the polymorphic `show` builtin and transforms the result.
; show 42     → "42"       → "42"       (number, pass through)
; show "hi"   → "\"hi\""   → "\"hi\""   (string, already quoted)
; show #t     → "#t"       → "true"
; show #f     → "#f"       → "false"
; show nil    → "nil"      → "null"
(define val-to-js (lambda (v)
  (let ((s (show v)))
    (if (string= s "#t") "true"
    (if (string= s "#f") "false"
    (if (string= s "nil") "null"
      s))))))

; Convert a list of Marlang values to a JS array body string.
(define args-to-js (lambda (args)
  (match args
    (Nil "")
    ((Cons h Nil) (val-to-js h))
    ((Cons h rest) (string-append (val-to-js h) "," (args-to-js rest))))))

; Render a mount-point div + a script that mounts a client component.
; div-id: unique DOM id for the mount div
; js-name: JS variable name of the component (must match define-client name)
; args: list of Marlang values to pass as component arguments
; The script connects the WebSocket (if not already connected) and waits
; for it to open before mounting, so server-proxied effects work.
(define __to-js-ident (lambda (name)
  (string-replace-all (string-replace-all name "-" "_") "?" "_p")))

(define __str-cat (lambda (parts)
  (match parts
    (Nil "")
    ((Cons h Nil) h)
    ((Cons h rest) (string-append h (__str-cat rest))))))

(define __mount-component (lambda (div-id js-name args)
  (let ((safe-name (__to-js-ident js-name)))
    (__str-cat (list
      "<div id=\"" div-id "\"></div>"
      "<script>marlang.connectAndMount(document.getElementById('"
      div-id "')," safe-name ",["
      (args-to-js args) "]);</script>")))))

; =========================================================================
; define-shared — define a pure function in both Marlang and JS
;
; Usage:
;   (js/define-shared double (x) (* x 2))
;
; Expands to:
;   (begin
;     (define double (lambda (x) (* x 2)))
;     (js/register-shared-js "const double = ((x) => (x * 2))"))
; =========================================================================

(defmacro define-shared (name params body)
  (list 'begin
    (list 'define name (list 'lambda params body))
    (list 'js/register-shared-js
      (list 'js/emit-js (list 'define name (list 'lambda params body))))))

; =========================================================================
; define-client — define a component in both Marlang (server) and JS (client)
;
; Usage:
;   (js/define-client counter (initial)
;     (let ((count (perform atom-new initial)))
;       (string-append (show (perform atom-read count)) " clicks")))
;
; The body is type-checked by the Marlang type checker using the declared
; Atom effect and any user-declared server effects. Type errors in the
; body (wrong arities, undeclared effects, type mismatches) are caught
; at compile time.
;
; At runtime on the server, the function renders a mount-point div + a
; <script> tag. The effectful body never runs server-side.
;
; On the client, the same body is compiled to a JS generator function
; driven by the client runtime. Atom effects are handled locally;
; unknown effects (server effects) are proxied over WebSocket.
; =========================================================================

; define-client : two forms
;
;   (js/define-client name (params) body)
;     Pure client or unguarded — no effect type checking beyond standard inference.
;     Auto-extracts perform calls for the wire allowlist.
;
;   (js/define-client name (params) (EffectType1 EffectType2 ...) body)
;     Guarded — the type checker enforces a closed effect row {Atom E1 E2 ...}.
;     If the body performs an operation from an undeclared effect, compile error.
;     The effect types also drive the wire allowlist via operation extraction.
;
; The macro detects which form by checking if the third argument is a list
; of uppercase symbols (effect types) vs an expression (body).

; Check if a symbol name looks like an effect type (starts with uppercase).
; Handles qualified names like js/Atom — checks the part after the last /.
(define __is-effect-type-name? (lambda (name)
  (let ((check-name (match (string-index-of name "/")
                      ((Some idx) (string-substring name (+ idx 1) (string-length name)))
                      (None name))))
    (match (string-char-at check-name 0)
      ((Some c) (if (>= (char-code c) 65) (<= (char-code c) 90) #f))
      (None #f)))))

(define __all-upper-symbols? (lambda (lst)
  (if (nil? lst) #t
  (if (pair? lst)
    (let ((h (car lst)))
      (if (symbol? h)
        (if (__is-effect-type-name? (symbol->string h))
          (__all-upper-symbols? (cdr lst))
          #f)
        #f))
    #f))))

; Build a closed effect row expression from user-provided effect type names.
; The effect types come from the call site (no hygiene marks).
; We include Atom (from the Atom effect declared in this module) via the
; user's import — so the user must list it if they use atom effects.
; For convenience, we add a fresh row variable to allow Atom effects
; implicitly, since they're always client-local.
; Actually: we use a CLOSED row with just the user-declared effects.
; Atom effects are declared in std:js, so the user must include js/Atom
; or just Atom if they `(import "std:js" as js)`.
;
; Simpler: use only the user-provided effect types. If they use atom
; effects, they must declare Atom in the list. This is explicit and clear.
(define __make-effect-row (lambda (effect-types)
  (cons '__effect_row effect-types)))

; Generate fresh type variable symbols for lambda parameters.
; (x y z) → (tp0 tp1 tp2) as symbols for use in type annotations.
; Names start lowercase so the type checker treats them as type variables
; even after hygiene marks are applied (e.g. tp0~1 still starts with 't').
(define __make-param-tvars (lambda (params idx)
  (match params
    (Nil (list))
    ((Cons _ rest)
      (Cons (string->symbol (string-append "tp" (show idx)))
            (__make-param-tvars rest (+ idx 1)))))))

(defmacro define-client (name params . rest)
  (let ((name-str (symbol->string name))
        (div-id (string-append "__mc_" (symbol->string name))))
    ; Detect form: rest = (effects body) or rest = (body)
    ; Two-element rest where first is a list of uppercase symbols = guarded form
    (if (if (pair? rest)
          (if (pair? (cdr rest))
            (if (nil? (cdr (cdr rest)))
              (if (pair? (car rest))
                (__all-upper-symbols? (car rest))
                #f)
              #f)
            #f)
          #f)
      ; --- Guarded form: (js/define-client name (params) (Effect1 Effect2) body) ---
      (let ((effect-types (car rest))
            (body (car (cdr rest)))
            (effects (__to-wire-names (__extract-effects (car (cdr rest))))))
        (list 'begin
          ; Type-check with closed effect row — the type checker enforces it.
          ; Annotate the lambda with a closed effect row. Param types use
          ; fresh type variables so they're inferred. If body performs
          ; an undeclared effect, the type checker reports a mismatch.
          (let ((param-tvars (__make-param-tvars params 0)))
            (list 'let
              (list (list (list '__tc ': (append (list '->) (append param-tvars (list (__make-effect-row effect-types) 'tcret))))
                          (list 'lambda params body)))
              'nil))
          ; Server-side: guarded mount with HMAC-signed allowlist
          (list 'define name (list 'lambda params
            (list 'js/__mount-guarded-component div-id name-str
              (__make-list-expr effects)
              (list 'w/sign-allowlist (__make-list-expr effects))
              (cons 'list params))))
          ; Client-side: register JS generator component
          (list 'js/register-client-js
            (list 'js/emit-js (list 'define name (list 'lambda* params body))))))
      ; --- Unguarded form: (js/define-client name (params) body) ---
      (let ((body (car rest))
            (effects (__to-wire-names (__extract-effects (car rest)))))
        (list 'begin
          ; Type-check the effectful body (standard inference, open row)
          (list 'let (list (list '__tc (list 'lambda params body))) 'nil)
          ; Server-side mount
          (if (nil? effects)
            (list 'define name (list 'lambda params
              (list 'js/__mount-component div-id name-str (cons 'list params))))
            (list 'define name (list 'lambda params
              (list 'js/__mount-guarded-component div-id name-str
                (__make-list-expr effects)
                (list 'w/sign-allowlist (__make-list-expr effects))
                (cons 'list params)))))
          ; Client-side: register JS generator component
          (list 'js/register-client-js
            (list 'js/emit-js (list 'define name (list 'lambda* params body)))))))))

; =========================================================================
; mount-script — generate JS to mount a client component on a DOM element
;
; Usage (in an HTML template):
;   (js/mount-script "app" "counter" (list 0))
;   => "<script>marlang.mount(document.getElementById('app'),
;       counter, [0], marlang.builtinHandlers);</script>"
; =========================================================================

(define mount-script (lambda (element-id component-name args-js)
  (string-append "<script>marlang.mount(document.getElementById('"
    element-id "'), " component-name ", "
    args-js ", marlang.builtinHandlers);</script>")))

; =========================================================================
; define-client-guarded — like define-client but with effect allowlists
;
; Usage:
;   (import "std:web" as w)
;   (import "std:js" as js)
;
;   (js/define-client-guarded user-profile (user-id) (db-query db-execute)
;     (let ((rows (perform db-query ...))) ...))
;
; The allowed-effects list specifies which effects may be proxied to the
; server. The server signs the allowlist with HMAC-SHA256 and embeds the
; signed token in the page. The client includes the token in effect proxy
; messages. The server validates the HMAC before dispatching.
;
; Atom effects (atom-new, atom-read, atom-set, atom-swap) are always
; handled locally on the client and do not need to be in the allowlist.
;
; Expands to:
;   (begin
;     (let ((__tc (lambda (params) body))) nil)   ; type-check
;     (define name (lambda (params)
;       (__mount-guarded-component div-id name-str
;         (list of allowed effect name strings)
;         (w/sign-allowlist (list of allowed effect name strings))
;         (list arg1 arg2 ...))))
;     (js/register-client-js (js/emit-js (define name (lambda* (params) body)))))
; =========================================================================

; Convert a list of effect name strings to a JS array literal.
(define __effects-to-js-items (lambda (effects)
  (match effects
    (Nil "")
    ((Cons h Nil) (string-append "\"" h "\""))
    ((Cons h rest) (string-append "\"" h "\"," (__effects-to-js-items rest))))))

(define __effects-to-js-array (lambda (effects)
  (string-append "[" (__effects-to-js-items effects) "]")))

; Mount a guarded client component — like __mount-component but embeds
; the allowlist and HMAC token in the mount script.
(define __mount-guarded-component (lambda (div-id js-name allowed-effects token args)
  (let ((allow-json (__effects-to-js-array allowed-effects))
        (safe-name (__to-js-ident js-name)))
    (__str-cat (list
      "<div id=\"" div-id "\"></div>"
      "<script>marlang.connectAndMountGuarded(document.getElementById('"
      div-id "')," safe-name ",["
      (args-to-js args) "],"
      allow-json ",\"" token "\");</script>")))))

; =========================================================================
; Effect extraction — walk an S-expression tree to find (perform op ...)
; calls and collect the unique effect names. These become the allowlist.
;
; Local effects (atom-new, atom-read, atom-set, atom-swap) are excluded
; since they're handled client-side and never proxied to the server.
; =========================================================================

(define __local-effects (list "atom-new" "atom-read" "atom-set" "atom-swap"))

(define __is-local-effect-in (lambda (name lst)
  (match lst
    (Nil #f)
    ((Cons h rest)
      (if (string= h name) #t
        (__is-local-effect-in name rest))))))

; Check if a string is in a list of strings.
(define __str-member (lambda (s lst)
  (match lst
    (Nil #f)
    ((Cons h rest)
      (if (string= s h) #t (__str-member s rest))))))

; Merge two lists, keeping only unique strings.
(define __str-union (lambda (a b)
  (match a
    (Nil b)
    ((Cons h rest)
      (if (__str-member h b)
        (__str-union rest b)
        (__str-union rest (Cons h b)))))))

; Walk an S-expression tree and collect server-side perform effect names.
; Returns a (List String) of unique, non-local effect names.
; Uses begin + define for mutual recursion (letrec semantics).
(define __extract-effects
  (let ()
    (begin
      (define walk-expr (lambda (expr)
        (if (pair? expr)
          (let ((head (car expr)))
            (if (symbol? head)
              (if (string= (symbol->string head) "perform")
                ; Found (perform op-name ...)
                (let ((op (car (cdr expr)))
                      (rest-effects (walk-list (cdr (cdr expr)))))
                  (if (symbol? op)
                    (let ((name (symbol->string op)))
                      (if (__is-local-effect-in name __local-effects)
                        rest-effects
                        (__str-union (list name) rest-effects)))
                    rest-effects))
                ; Not a perform — walk all children
                (walk-list expr))
              (walk-list expr)))
          (list))))
      (define walk-list (lambda (lst)
        (if (nil? lst) (list)
        (if (pair? lst)
          (__str-union (walk-expr (car lst))
                       (walk-list (cdr lst)))
          (list)))))
      walk-expr)))

; Convert effect names to underscore form for the wire protocol.
(define __to-wire-names (lambda (names)
  (match names
    (Nil (list))
    ((Cons h rest)
      (Cons (string-replace-all h "-" "_")
            (__to-wire-names rest))))))

; Build a (list "str1" "str2" ...) S-expression from a list of strings.
(define __make-list-expr (lambda (strings)
  (cons 'list strings)))

; Verify that every extracted effect is covered by the allowlist.
; Raises a compile-time error (via perform throw) if any effect is missing.
(define __check-allowlist-covers (lambda (component-name extracted allowed)
  (match extracted
    (Nil nil)
    ((Cons eff rest)
      (if (__str-member eff allowed)
        (__check-allowlist-covers component-name rest allowed)
        (perform throw
          (__str-cat (list
            "define-client-guarded '" component-name
            "': body performs '" eff
            "' which is not in the allowlist."))))))))

; Verify allowlist doesn't have extra unused effects (warning-like).
; Not an error — the allowlist may intentionally include effects used
; only in inline JS handlers (onclick etc.), which aren't extracted.

; =========================================================================
; define-client-guarded — explicit allowlist (manual control)
;
; Usage:
;   (js/define-client-guarded widget (x) (load-data save-data)
;     (let ((d (perform load-data "k"))) ...))
;
; The allowlist is specified manually. No compile-time check that
; the body only uses effects in the list — use define-client instead
; for automatic extraction.
; =========================================================================

; Convert a list of symbols to a list of underscore-form strings.
(define __symbols-to-effect-names (lambda (syms)
  (match syms
    (Nil (list))
    ((Cons s rest)
      (Cons (string-replace-all (symbol->string s) "-" "_")
            (__symbols-to-effect-names rest))))))

(defmacro define-client-guarded (name params allowed-effects body)
  (let ((name-str (symbol->string name))
        (div-id (string-append "__mc_" (symbol->string name)))
        (effect-names (__symbols-to-effect-names allowed-effects))
        ; Auto-extract effects from the body to cross-check
        (extracted (__to-wire-names (__extract-effects body))))
    (begin
      ; Verify: every extracted server effect must be in the allowlist
      (__check-allowlist-covers name-str extracted effect-names)
      (list 'begin
        ; Type-check the effectful body
        (list 'let (list (list '__tc (list 'lambda params body))) 'nil)
        ; Server-side: mount function that embeds signed allowlist
        (list 'define name (list 'lambda params
          (list 'js/__mount-guarded-component div-id name-str
            (__make-list-expr effect-names)
            (list 'w/sign-allowlist (__make-list-expr effect-names))
            (cons 'list params))))
        ; Client-side: register JS generator component
        (list 'js/register-client-js
          (list 'js/emit-js (list 'define name (list 'lambda* params body))))))))

; =========================================================================
; Batch — collect independent effects into single WebSocket messages
;
; Usage (in a define-client body):
;   (js/define-client dashboard (user-id)
;     (let ((results (perform batch
;             (list (MkPair "load_user" (list user-id))
;                   (MkPair "load_posts" (list user-id))))))
;       ; results is a list of result values
;       ...))
;
; Or using the batch macro for cleaner syntax:
;   (js/batch
;     ((user  (perform load-user user-id))
;      (posts (perform load-posts user-id)))
;     (render-page user posts))
;
; Protocol:
;   Client → Server: {"type":"batch","id":1,"effects":[...]}
;   Server → Client: {"type":"batch_result","id":1,"results":[...]}
; =========================================================================

; Effect declaration for batch — the type checker needs this
(effect Batch
  (batch (-> (List (Pair String (List String))) (List String))))

; The batch macro compiles to JS that sends all effects in one message.
; On the server, web.mar handles the batch protocol.
;
; (js/batch
;   ((user  (perform load-user uid))
;    (posts (perform load-posts uid)))
;   body)
;
; Compiles to JS that:
;   1. Collects all effect descriptors into an array
;   2. Sends them as a single batch message
;   3. Destructures the results array into the bindings
;   4. Evaluates the body

(defmacro batch (bindings body)
  ((lambda ()

    ; Extract effect descriptors from bindings
    ; Each binding is (name (perform effect-name args...))
    ; We need to collect: [{effect, args}, ...] and bind results

    (define binding-names (lambda (bs)
      (match bs
        (Nil (list))
        ((Cons b rest)
          (Cons (car b) (binding-names rest))))))

    ; Build the JS batch call expression.
    ; In Marlang (server), the batch form just executes sequentially.
    ; On the client (JS), the emit-js compiler handles it differently.
    ;
    ; Server-side expansion: sequential execution with let bindings
    ; (let ((name1 expr1) (name2 expr2)) body)
    (list 'let bindings body))))

; =========================================================================
; Prefetch — inline data in the page to avoid first-render round-trips
;
; Usage:
;   (import "std:web" as w)
;   (import "std:js" as js)
;
;   (define render-page (lambda (user-id)
;     (w/html (list)
;       (string-append
;         (w/head (string-append
;           (js/client-bundle-script)
;           (js/prefetch (list
;             (MkPair "load_user" (show (load-user-from-db user-id)))
;             (MkPair "load_posts" (show (load-posts-from-db user-id)))))))
;         (w/body (list) (user-profile user-id))))))
;
; The prefetch data is inlined as a <script> tag:
;   <script>window.__prefetch = {"load_user":"...","load_posts":"..."};</script>
;
; The client runtime checks window.__prefetch before proxying an effect
; to the server. If a matching entry exists, it's consumed immediately
; (one-time use) without a WebSocket round-trip.
; =========================================================================

; Render prefetch entries as JS object properties.
(define __prefetch-entries (lambda (entries)
  (match entries
    (Nil "")
    ((Cons (MkPair key val) Nil)
      (string-append "\"" key "\":" (show val)))
    ((Cons (MkPair key val) rest)
      (string-append "\"" key "\":" (show val) "," (__prefetch-entries rest))))))

(define __prefetch-assigns (lambda (entries)
  (match entries
    (Nil "")
    ((Cons (MkPair key val) rest)
      (string-append
        "window.__prefetch[\"" key "\"]=" (show val) ";"
        (__prefetch-assigns rest))))))

; prefetch : (-> (List (Pair String String)) String)
; Generate a <script> tag that inlines prefetch data for client components.
; Each entry is (MkPair effect-key result-value).
; The effect-key should match what the client sends (underscore form).
; The result-value is the pre-computed result as a string.
;
; Multiple calls to prefetch accumulate entries — they don't overwrite.
(define prefetch (lambda (entries)
  (string-append
    "<script>window.__prefetch=window.__prefetch||{};"
    (string-append (__prefetch-assigns entries)
      "</script>"))))

; prefetch-key : construct the cache key: effect_name:arg1,arg2,...
(define prefetch-key (lambda (effect-name args)
  (string-append effect-name ":"
    (match args
      (Nil "")
      ((Cons h Nil) h)
      ((Cons h rest) (string-append h ","
        (match rest
          (Nil "")
          ((Cons h2 Nil) h2)
          ((Cons h2 rest2) (string-append h2 ","
            (match rest2
              (Nil "")
              (_ "...")))))))))))

; prefetch-effect : (-> String (List String) String String)
; Generate a prefetch entry for a single effect with its pre-computed result.
(define prefetch-effect (lambda (effect-name args result)
  (let ((key (prefetch-key effect-name args)))
    (prefetch (list (MkPair key result))))))
