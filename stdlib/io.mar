; IO module - Basic IO operations using the effect system
;
; This module provides effectful IO operations. To use them, you must
; wrap your effectful code in a handler that provides the actual IO.
;
; Example usage:
;   (import "std:io" as io)
;
;   (handle
;     (begin
;       (io/println "Hello, world!")
;       (io/print "Enter your name: ")
;       (let ((name (io/read-line)))
;         (io/println (string-append "Hello, " name "!"))))
;     ((print msg k) -> (begin (display msg) (resume k nil)))
;     ((println msg k) -> (begin (displayln msg) (resume k nil)))
;     ((read-line k) -> (resume k (read-string))))
;
; For file operations, the handler must implement read-file and write-file.

; === IO Effect ===
;
; The IO effect provides operations for console and file IO.

(effect IO
  (print (=> (Show a) (-> a Unit)))
  (println (=> (Show a) (-> a Unit)))
  (read-line (-> Unit String))
  (read-file (-> String (Result String String)))
  (write-file (-> String String (Result String Unit))))

; === Console IO Operations ===

; print : forall a. (Show a) => (-> a {IO} Unit)
; Output a value without a newline
(define print (lambda (msg) (perform print msg)))

; println : forall a. (Show a) => (-> a {IO} Unit)
; Output a value with a newline
(define println (lambda (msg) (perform println msg)))

; read-line : (-> Unit {IO} String)
; Read a line of input from stdin
(define read-line (lambda () (perform read-line)))

; === File IO Operations ===
;
; Raw operations return (Result String a). Throwing variants (read-file!, write-file!)
; unwrap the Result and throw on error via the Exception effect.

; read-file : (-> String {IO} (Result String String))
; Read the entire contents of a file. Returns (Ok content) or (Err msg).
(define read-file (lambda (path) (perform read-file path)))

; read-file! : (-> String {IO, Exception} String)
; Read the entire contents of a file. Throws on error.
(define read-file! (lambda (path)
  (match (perform read-file path)
    ((Ok content) content)
    ((Err msg) (perform throw msg)))))

; write-file : (-> String String {IO} (Result String Unit))
; Write a string to a file (overwrites existing content). Returns (Ok nil) or (Err msg).
(define write-file (lambda (path content) (perform write-file path content)))

; write-file! : (-> String String {IO, Exception} Unit)
; Write a string to a file. Throws on error.
(define write-file! (lambda (path content)
  (match (perform write-file path content)
    ((Ok _) nil)
    ((Err msg) (perform throw msg)))))

; === Convenience Functions ===

; print-int : (-> Int {IO} Unit)
; Print an integer
(define print-int (lambda (n) (perform print (show n))))

; println-int : (-> Int {IO} Unit)
; Print an integer with a newline
(define println-int (lambda (n) (perform println (show n))))

; print-bool : (-> Bool {IO} Unit)
; Print a boolean
(define print-bool (lambda (b) (perform print (show b))))

; println-bool : (-> Bool {IO} Unit)
; Print a boolean with a newline
(define println-bool (lambda (b) (perform println (show b))))

; === Async IO Effects (for use inside run-fibers) ===

(effect AsyncIO
  (io-stdout    (-> Unit Channel))
  (io-stderr    (-> Unit Channel))
  (io-stdin     (-> Unit Channel))
  (io-read-file  (-> String String))
  (io-write-file (-> String String Unit))
  (io-open-file  (-> String String Channel)))

(define stdout     (lambda () (perform io-stdout)))
(define stderr     (lambda () (perform io-stderr)))
(define stdin      (lambda () (perform io-stdin)))
(define async-read-file  (lambda (path) (perform io-read-file path)))
(define async-write-file (lambda (path content) (perform io-write-file path content)))
(define open-file  (lambda (path mode) (perform io-open-file path mode)))
