; Prelude — auto-loaded into every Marlang program
;
; Type declarations for all VM builtins live in types/builtins.rs (the
; authoritative source for the type checker). This file only defines
; data types, effects, macros, and core utility functions.
;
; Domain-specific builtins are accessed via stdlib imports:
;   (import "std:string" as str)   ; str/append, str/split, etc.
;   (import "std:math" as math)    ; math/sqrt, math/sin, etc.

; --- Data Types ---
(data (Option a) None (Some a))
(data (List a) Nil (Cons a (List a)))
(data (Pair a b) (MkPair a b))
(data (Result e a) (Err e) (Ok a))

; --- Effects ---
(effect Exception
  (throw (-> String a)))

; --- Macros ---
(defmacro when (cond body)
  `(if ,cond (begin ,body nil) nil))

; --- Core Functions ---

; raise : (-> String {Exception} a)
; Throw an exception with a message. Wrapper around (perform throw msg).
(define raise (lambda (msg) (perform throw msg)))

; string->number: parses a string to a Float, throws on failure
(define string->number (lambda (s)
  (match (__try-string->number s)
    ((Some n) n)
    (None (raise (string-append "string->number: invalid number: " s))))))

(define not (lambda (x) (if x #f #t)))
(define cons (lambda (h t) (Cons h t)))
(define car (lambda (l) (match l ((Cons h _) h) (Nil (error "car: empty list")))))
(define cdr (lambda (l) (match l ((Cons _ t) t) (Nil (error "cdr: empty list")))))
(define append
  (lambda (xs ys)
    (match xs
      (Nil ys)
      ((Cons h t) (Cons h (append t ys))))))
