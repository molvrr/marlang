; HTTP module - HTTP client using the effect system
;
; All HTTP operations are effects handled by the always-on scheduler.
; They work at the top level — no wrapper needed.
;
; The client API uses a type-safe HttpMethod ADT and returns HttpResponse values
; with status code, headers, and a Bytes body. Convenience wrappers handle
; common cases (GET/POST with string bodies).
;
; Failable operations follow the stdlib convention:
;   - Safe variants (request, get, post, ...): return (Result String HttpResponse)
;   - Throwing variants (request!, get!, post!, ...): unwrap and raise on error
;
; Example usage (throwing):
;   (import "std:http" as http)
;   (import "std:io" as io)
;
;   (let ((resp (http/get! "http://example.com")))
;     (match resp
;       ((HttpResponse status headers body)
;         (match (bytes-to-string body)
;           ((Ok text) (io/println text))
;           ((Err msg) (io/println (string-append "decode error: " msg)))))))
;
; Example usage (safe):
;   (import "std:http" as http)
;   (import "std:io" as io)
;
;   (match (http/get "http://example.com")
;     ((Ok (HttpResponse status headers body))
;       (io/println (string-append "status: " (show status))))
;     ((Err msg)
;       (io/println (string-append "request failed: " msg))))
;
; Both HTTP and HTTPS are supported. HTTPS uses rustls with native OS
; certificates (no bundled certificate store). TLS errors are returned as
; (Err msg) just like connection errors.
;
; Future work:
;   - HTTP server effects (http-serve, http-accept, http-respond)
;   - Streaming request/response bodies
;   - Pure Marlang HTTP parser on TCP + codec (alternative implementation)

; === Data Types ===

(data HttpMethod GET POST PUT DELETE PATCH HEAD OPTIONS)

(data HttpResponse (HttpResponse Int (List (Pair String String)) Bytes))
;                   status       headers                        body

; === HTTP Client Effect ===

(effect HttpClient
  (http-request (-> HttpMethod String (List (Pair String String)) Bytes
                    (Result String HttpResponse))))

; === Safe wrappers (return Result) ===

; request : (-> HttpMethod String (List (Pair String String)) Bytes
;               {HttpClient} (Result String HttpResponse))
; Make an HTTP request. Returns (Ok response) or (Err msg).
(define request (lambda (method url headers body)
  (perform http-request method url headers body)))

; get : (-> String {HttpClient} (Result String HttpResponse))
; Make a GET request. Returns (Ok response) or (Err msg).
(define get (lambda (url)
  (request GET url (list) (bytes-new 0))))

; post : (-> String (List (Pair String String)) Bytes
;             {HttpClient} (Result String HttpResponse))
; Make a POST request. Returns (Ok response) or (Err msg).
(define post (lambda (url headers body)
  (request POST url headers body)))

; put : (-> String (List (Pair String String)) Bytes
;            {HttpClient} (Result String HttpResponse))
; Make a PUT request. Returns (Ok response) or (Err msg).
(define put (lambda (url headers body)
  (request PUT url headers body)))

; delete : (-> String {HttpClient} (Result String HttpResponse))
; Make a DELETE request. Returns (Ok response) or (Err msg).
(define delete (lambda (url)
  (request DELETE url (list) (bytes-new 0))))

; === Internal helper ===

(define unwrap-or-throw (lambda (result label)
  (match result
    ((Ok v) v)
    ((Err msg) (raise (string-append label ": " msg))))))

; === Throwing wrappers ===

; request! : (-> HttpMethod String (List (Pair String String)) Bytes
;                {HttpClient, Exception} HttpResponse)
; Make an HTTP request. Throws on failure.
(define request! (lambda (method url headers body)
  (unwrap-or-throw (request method url headers body) "http-request")))

; get! : (-> String {HttpClient, Exception} HttpResponse)
; Make a GET request. Throws on failure.
(define get! (lambda (url)
  (unwrap-or-throw (get url) "http-get")))

; post! : (-> String (List (Pair String String)) Bytes
;              {HttpClient, Exception} HttpResponse)
; Make a POST request. Throws on failure.
(define post! (lambda (url headers body)
  (unwrap-or-throw (post url headers body) "http-post")))

; put! : (-> String (List (Pair String String)) Bytes
;             {HttpClient, Exception} HttpResponse)
; Make a PUT request. Throws on failure.
(define put! (lambda (url headers body)
  (unwrap-or-throw (put url headers body) "http-put")))

; delete! : (-> String {HttpClient, Exception} HttpResponse)
; Make a DELETE request. Throws on failure.
(define delete! (lambda (url)
  (unwrap-or-throw (delete url) "http-delete")))

; === String convenience wrappers ===

; post-text : (-> String (List (Pair String String)) String
;                 {HttpClient} (Result String HttpResponse))
; Make a POST request with a string body (UTF-8 encoded).
(define post-text (lambda (url headers body)
  (post url headers (bytes-from-string body))))

; post-text! : (-> String (List (Pair String String)) String
;                  {HttpClient, Exception} HttpResponse)
; Make a POST request with a string body. Throws on failure.
(define post-text! (lambda (url headers body)
  (post! url headers (bytes-from-string body))))
