; Actor Model Example
;
; Actors are fibers with mailboxes. They communicate via
; asynchronous message passing, inspired by Erlang/Elixir.
;
; Run with: cargo run -p marlang-cli -- run examples/actors.mar

(import "std:concurrent" as conc)
(import "std:actor" as actor)
(import "std:io" as io)

; === Example 1: Ping-Pong ===
;
; Two actors exchanging messages back and forth

(data PingPong (Ping Pid) (Pong Pid))

(define pong (lambda ()
  (let ((msg (actor/receive)))
    (match msg
      ((Ping sender)
        (let ((me (conc/self)))
          (actor/send sender (Pong me))
          (pong)))
      (_ (pong))))))

(define ping (lambda (partner n)
  (if (<= n 0)
    (io/println "ping-pong done!")
    (let ((me (conc/self)))
      (actor/send partner (Ping me))
      (let ((msg (actor/receive)))
        (match msg
          ((Pong _) (ping partner (- n 1)))
          (_ nil)))))))
(run-fibers (lambda ()
  (let ((p (conc/spawn pong)))
    (ping p 5))))

; Output:
;   ping-pong done!


; === Example 2: Counter Actor ===
;
; A stateful actor that processes messages in a loop

(data CounterMsg
  (Increment Int)
  (GetCount Pid))
(data CounterReply
  (Count Int))

(define counter (lambda (count)
  (let ((msg (actor/receive)))
    (match msg
      ((Increment n) (counter (+ count n)))
      ((GetCount sender)
        (begin
          (actor/send sender (Count count))
          (counter count)))))))

(run-fibers (lambda ()
  (let ((c (conc/spawn (lambda () (counter 0))))
        (me (conc/self)))
    (actor/send c (Increment 5))
    (actor/send c (Increment 3))
    (actor/send c (Increment 10))
    (actor/send c (GetCount me))
    (let ((reply (actor/receive)))
      (match reply
        ((Count n) (begin (io/print "count = ") (io/println n))))))))

; Output:
;   count = 18


; === Example 3: Selective Receive ===
;
; Receive only messages matching a predicate

(data Priority (High String) (Low String))

(run-fibers (lambda ()
  (let ((me (conc/self)))

    ; Send low-priority then high-priority
    (conc/spawn (lambda ()
      (actor/send me (Low "boring"))
      (actor/send me (High "urgent"))
      (actor/send me (Low "meh"))))

    (conc/yield)
    (conc/yield)

    ; Receive only High messages first
    (let ((msg (actor/receive-match
                 (lambda (m) (match m ((High _) #t) (_ #f))))))
      (match msg
        ((High s) (io/println s))
        (_ nil)))

    ; Then drain the rest
    (let ((msg (actor/receive)))
      (match msg
        ((Low s) (io/println s))
        (_ nil)))
    (let ((msg (actor/receive)))
      (match msg
        ((Low s) (io/println s))
        (_ nil))))))

; Output:
;   urgent
;   boring
;   meh
