; Calculator Example — using std:parse
;
; Parses and evaluates simple arithmetic expressions:
;   1 + 2 * 3       => 7
;   (1 + 2) * 3     => 9
;   10 - 3 - 2      => 5  (left-associative)
;
; Grammar:
;   expr   = term (('+' | '-') term)*
;   term   = factor (('*' | '/') factor)*
;   factor = '(' expr ')' | integer
;
; Run with: cargo run -p marlang-cli -- run examples/parse-calc.mar

(import "std:parse" as p)
(import "std:io" as io)

; === Forward-declare expr so factor can reference it ===
; Use a mutable-like thunk. Since we don't have mutation,
; we'll structure the parsers to avoid mutual recursion by
; inlining the grammar recursion.

; Actually: define expr first, having it call term, which calls factor,
; which calls expr. Since lambdas delay evaluation, all we need is for
; the *names* to be bound before any of them are *called*.
; In Marlang, top-level defines are sequential, so 'expr' is not yet
; bound when 'factor' is defined. But since 'factor' is a lambda,
; 'expr' only needs to be bound when 'factor' is *called*, not defined.
; Let's check if Marlang closes over the variable name lazily...

; Actually, closures capture from the lexical scope at *definition* time.
; If 'expr' isn't defined yet, the closure can't capture it.
; Solution: put everything in a single let-rec-like structure,
; or use the classic trick of passing self as an argument.

; Simplest: just don't use mutual recursion. Have expr/term/factor
; all be lambdas in a letrec, or define a single recursive function
; that dispatches on a "level" parameter.

; Approach: single function with a level parameter
; level 0 = expr, level 1 = term, level 2 = factor

(define parse-expr (lambda (level)
  (if (= level 0)
    ; expr: term chained with + and -
    (p/chainl1
      (lambda ()
        (begin
          (p/spaces)
          (p/choice (list
            (lambda () (begin (p/char (char-from-code 43)) (p/spaces) +.))
            (lambda () (begin (p/char (char-from-code 45)) (p/spaces) -.))))))
      (lambda () (parse-expr 1)))
  (if (= level 1)
    ; term: factor chained with * and /
    (p/chainl1
      (lambda ()
        (begin
          (p/spaces)
          (p/choice (list
            (lambda () (begin (p/char (char-from-code 42)) (p/spaces) *.))
            (lambda () (begin (p/char (char-from-code 47)) (p/spaces) /.))))))
      (lambda () (parse-expr 2)))
    ; factor: parens or integer
    (begin
      (p/spaces)
      (p/or-else
        (lambda () (p/parens (lambda () (parse-expr 0))))
        (lambda () (p/integer))))))))

; Top-level parser
(define calc (lambda (input)
  (p/run (lambda ()
    (let ((result (parse-expr 0)))
      (begin (p/spaces) (p/eof) result)))
    input)))

; === Tests ===

(define test (lambda (input expected)
  (let ((result (calc input)))
    (match result
      ((Ok val) (io/println (string-append input
        (string-append " = " (string-append (show val)
          (if (=. val expected) " OK" " FAIL"))))))
      ((Err msg) (io/println (string-append input
        (string-append " => ERROR: " msg))))))))

(test "42" 42.0)
(test "1 + 2" 3.0)
(test "1 + 2 * 3" 7.0)
(test "10 - 3 - 2" 5.0)
(test "(1 + 2) * 3" 9.0)
(test "100 / 5 / 4" 5.0)
(test " 3 + 4 * 2 / (1 - 5)" 1.0)
(test "0" 0.0)
(test "-7" -7.0)

; Error case
(let ((result (calc "1 +")))
  (io/println (string-append "1 + => " (show result))))
