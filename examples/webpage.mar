; =========================================================================
; Live Dashboard — web framework with WebSocket + morphdom
;
; A shared counter + message board. State lives in live sources that
; auto-push HTML fragments to all connected clients via WebSocket.
; The client uses morphdom for efficient DOM patching.
;
; Run with:
;   cargo run -p marlang-cli -- run examples/web-mvp.mar
;
; Then open http://127.0.0.1:3000 in two browser tabs.
; =========================================================================

(import "std:web" as w)
(import "std:io" as io)

; =========================================================================
; Render helpers (must be defined before live sources that reference them)
; =========================================================================

(define map-msg (lambda (msgs)
  (match msgs
    (Nil (list))
    ((Cons (MkPair author msg-text) rest)
      (Cons
        (w/div (list (MkPair "class" "msg"))
          (string-append
            (w/span (list (MkPair "class" "msg-author")) (w/text author))
            " "
            (w/span (list) (w/text msg-text))))
        (map-msg rest))))))

(define render-messages (lambda (msgs)
  (if (nil? msgs)
    (w/p (list (MkPair "class" "empty")) "No messages yet.")
    (w/join (map-msg msgs)))))

; =========================================================================
; Live sources — auto-push to all WebSocket clients on change
; =========================================================================

(define counter (w/live 0
  (lambda (n) (show n))))

(define doubled (w/live-map counter
  (lambda (n) (* n 2))
  (lambda (n) (show n))))

(define messages (w/live (list)
  render-messages))

; =========================================================================
; Layout
; =========================================================================

(define css "
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 0 auto; padding: 2rem; color: #1a1a1a; }
  h1 { margin-bottom: 1.5rem; }
  h2 { margin-bottom: 0.75rem; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; }
  .card { background: #f8f8f8; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
  .counter-display { font-size: 3rem; font-weight: bold; text-align: center; padding: 1rem 0; font-variant-numeric: tabular-nums; }
  .counter-buttons { display: flex; gap: 0.5rem; justify-content: center; }
  .counter-buttons button { font-size: 1.1rem; padding: 0.5rem 1.5rem; border: 1px solid #ccc; border-radius: 6px; background: white; cursor: pointer; }
  .counter-buttons button:hover { background: #eee; }
  .msg-form { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .msg-form input { flex: 1; padding: 0.5rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; }
  .msg-form button { padding: 0.5rem 1rem; border: none; border-radius: 6px; background: #333; color: white; cursor: pointer; font-size: 1rem; }
  .msg-form button:hover { background: #555; }
  .msg { padding: 0.5rem 0; border-bottom: 1px solid #eee; }
  .msg:last-child { border-bottom: none; }
  .msg-author { font-weight: 600; }
  .empty { color: #999; font-style: italic; }
  .status { font-size: 0.75rem; text-align: right; margin-top: 2rem; }
  .status .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; background: #ccc; }
  .status .dot.live { background: #4a4; }
")

(define layout (lambda (title-text body-html)
  (w/html (list (MkPair "lang" "en"))
    (string-append
      (w/head (string-append
        (w/title title-text)
        (w/meta (list (MkPair "charset" "utf-8")))
        (w/meta (list (MkPair "name" "viewport") (MkPair "content" "width=device-width,initial-scale=1")))
        (w/style css)
        (w/live-scripts)))
      (w/body (list)
        (string-append
          (w/nav (list (MkPair "style" "margin-bottom:1.5rem;display:flex;gap:1rem"))
            (string-append
              (w/a (list (MkPair "href" "/")) "Dashboard")
              (w/a (list (MkPair "href" "/about")) "About")))
          body-html))))))

; =========================================================================
; Handlers
; =========================================================================

(define handle-home (lambda ()
  (w/ok
    (layout "Live Dashboard"
      (string-append
        (w/h1 (list) "Live Dashboard")

        ; --- Counter section ---
        (w/div (list (MkPair "class" "card"))
          (string-append
            (w/h2 (list) "Shared Counter")
            (w/live-el "div" counter (list (MkPair "class" "counter-display")))
            (w/p (list (MkPair "style" "text-align:center;color:#666;font-size:0.9rem"))
              (string-append "doubled: "
                (w/live-el "span" doubled (list))))
            (w/div (list (MkPair "class" "counter-buttons"))
              (string-append
                (w/button (list (MkPair "onclick" "post('/api/decrement')")) "-")
                (w/button (list (MkPair "onclick" "post('/api/increment')")) "+")
                (w/button (list (MkPair "onclick" "post('/api/reset')")) "Reset")))))

        ; --- Messages section ---
        (w/div (list (MkPair "class" "card"))
          (string-append
            (w/h2 (list) "Message Board")
            (w/form (list (MkPair "class" "msg-form")
                          (MkPair "onsubmit" "return submitForm(this,'/api/message')"))
              (string-append
                (w/input (list (MkPair "type" "text")
                               (MkPair "name" "author")
                               (MkPair "placeholder" "Name")
                               (MkPair "required" "true")))
                (w/input (list (MkPair "type" "text")
                               (MkPair "name" "text")
                               (MkPair "placeholder" "Message...")
                               (MkPair "required" "true")))
                (w/button (list (MkPair "type" "submit")) "Send")))
            (w/live-el "div" messages (list))))

        ; Status indicator
        (w/p (list (MkPair "class" "status"))
          (string-append
            (w/span (list (MkPair "class" "dot ws-dot")) "")
            " Live via WebSocket")))))))

(define handle-about (lambda ()
  (w/ok
    (layout "About"
      (w/div (list (MkPair "class" "card"))
        (string-append
          (w/h1 (list) "About")
          (w/p (list) "Live Dashboard &mdash; a real-time collaborative app powered by Marlang.")
          (w/p (list (MkPair "style" "margin-top:0.75rem;color:#666"))
            "State is shared across all connected clients via WebSocket. Navigation happens over WebSocket too &mdash; no full page reloads.")))))))

; --- API endpoints ---

(define handle-increment (lambda ()
  (w/live-update counter (lambda (n) (+ n 1)))
  (w/ok "")))

(define handle-decrement (lambda ()
  (w/live-update counter (lambda (n) (- n 1)))
  (w/ok "")))

(define handle-reset (lambda ()
  (w/live-set counter 0)
  (w/ok "")))

(define handle-post-message (lambda ()
  (let ((author (match (w/form-val "author") ((Some a) a) (None "Anon")))
        (msg-text (match (w/form-val "text") ((Some t) t) (None ""))))
    (w/live-update messages (lambda (msgs) (Cons (MkPair author msg-text) msgs)))
    (w/ok ""))))

; =========================================================================
; Routes & Start
; =========================================================================

(define routes (list
  (w/GET  "/"              handle-home)
  (w/GET  "/about"         handle-about)
  (w/POST "/api/increment" handle-increment)
  (w/POST "/api/decrement" handle-decrement)
  (w/POST "/api/reset"     handle-reset)
  (w/POST "/api/message"   handle-post-message)))

(w/run-live! 3000 routes)
