; Supervision Example
;
; Monitors and links provide fault-tolerance patterns
; inspired by Erlang's "let it crash" philosophy.
;
; Run with: cargo run -p marlang-cli -- run examples/supervision.mar

(import "std:concurrent")
(import "std:actor")
(import "std:io")

(data Signal (Down Pid String) (Exit Pid String))

; === Example 1: Monitor ===
;
; A monitor watches another fiber. When the watched fiber exits
; (normally or by crashing), a Down message is delivered.

(run-fibers (lambda ()
  (let ((worker (perform fiber-spawn (lambda ()
                  (perform println "worker: doing work...")
                  (perform fiber-yield)
                  (error "something went wrong!")))))
    (perform actor-monitor worker)
    (perform fiber-yield)
    (perform fiber-yield)
    (perform fiber-yield)
    (let ((msg (perform actor-receive)))
      (match msg
        ((Down pid reason) (begin (perform print "supervisor: worker crashed with: ") (perform println reason)))
        (_ nil))))))

; Output:
;   worker: doing work...
;   supervisor: worker crashed with: something went wrong!


; === Example 2: Link with Trap-Exit ===
;
; Links are bidirectional. When a linked fiber crashes, the linked
; partner also crashes — unless it has trap-exit enabled, in which
; case the crash is converted to an Exit message.

(run-fibers (lambda ()
  (perform actor-trap-exit #t)
  (let ((worker (perform fiber-spawn (lambda ()
                  (perform fiber-yield)
                  (error "crash!")))))
    (perform actor-link worker)
    (perform fiber-yield)
    (perform fiber-yield)
    (perform fiber-yield)
    (let ((msg (perform actor-receive)))
      (match msg
        ((Exit pid reason) (begin (perform print "trapped exit: ") (perform println reason)))
        (_ nil))))))

; Output:
;   trapped exit: crash!


; === Example 3: Restart on Crash ===
;
; A simple supervisor that restarts a worker when it crashes

(define run-worker (lambda ()
  (perform println "worker started")
  (perform fiber-yield)
  (error "oops")))

(define supervisor (lambda (restarts-left)
  (if (<= restarts-left 0)
    (perform println "supervisor: giving up")
    (let ((w (perform fiber-spawn run-worker)))
      (perform actor-monitor w)
      (perform fiber-yield)
      (perform fiber-yield)
      (perform fiber-yield)
      (let ((msg (perform actor-receive)))
        (match msg
          ((Down pid reason)
            (begin
              (perform print "supervisor: restarting after: ")
              (perform println reason)
              (supervisor (- restarts-left 1))))
          (_ nil)))))))

(run-fibers (lambda ()
  (supervisor 3)))

; Output:
;   worker started
;   supervisor: restarting after: oops
;   worker started
;   supervisor: restarting after: oops
;   worker started
;   supervisor: restarting after: oops
;   supervisor: giving up
