(define make-vector2 (lambda (x y)
  (struct-new Vector2 x y)))

(define make-vector3 (lambda (x y z)
  (struct-new Vector3 x y z)))

(define make-color (lambda (r g b a)
  (struct-new Color r g b a)))

(define make-rect (lambda (x y w h)
  (struct-new Rectangle x y w h)))

(define init-window (lambda (width height title)
  (ffi-call rl "InitWindow" width height title)))

(define close-window (lambda ()
  (ffi-call rl "CloseWindow")))

(define window-should-close (lambda ()
  (ffi-call rl "WindowShouldClose")))

(define begin-drawing (lambda ()
  (ffi-call rl "BeginDrawing")))

(define end-drawing (lambda ()
  (ffi-call rl "EndDrawing")))

(define clear-background (lambda (color)
  (ffi-call rl "ClearBackground" color)))

(define set-target-fps (lambda (fps)
  (ffi-call rl "SetTargetFPS" fps)))

(define get-fps (lambda ()
  (ffi-call rl "GetFPS")))

(define get-frame-time (lambda ()
  (ffi-call rl "GetFrameTime")))

(define draw-text (lambda (text x y size color)
  (ffi-call rl "DrawText" text x y size color)))

(define draw-fps (lambda (x y)
  (ffi-call rl "DrawFPS" x y)))

(define draw-circle (lambda (x y radius color)
  (ffi-call rl "DrawCircle" x y radius color)))

(define draw-rectangle (lambda (x y w h color)
  (ffi-call rl "DrawRectangle" x y w h color)))

(define draw-line (lambda (x1 y1 x2 y2 color)
  (ffi-call rl "DrawLine" x1 y1 x2 y2 color)))

(define is-key-pressed (lambda (key)
  (ffi-call rl "IsKeyPressed" key)))

(define is-key-down (lambda (key)
  (ffi-call rl "IsKeyDown" key)))

(define get-mouse-x (lambda ()
  (ffi-call rl "GetMouseX")))

(define get-mouse-y (lambda ()
  (ffi-call rl "GetMouseY")))

(define is-mouse-button-pressed (lambda (button)
  (ffi-call rl "IsMouseButtonPressed" button)))

(define is-mouse-button-down (lambda (button)
  (ffi-call rl "IsMouseButtonDown" button)))

(init-window 800 600 "Marlang + Raylib")
(set-target-fps 60)

(define loop (lambda (f)
  (if (window-should-close)
    nil
    (let ((a (begin-drawing))
          (b (clear-background RAYWHITE))
          (c (draw-text "Hello from Marlang + Raylib!" 150 200 40 DARKGRAY))
          (d (draw-text "Press ESC to exit" 280 260 20 GRAY))
          (e (draw-circle 400 400 80 RED))
          (g (draw-circle 300 350 40 BLUE))
          (h (draw-circle 500 350 40 GREEN))
          (i (draw-rectangle 50 50 100 60 ORANGE))
          (j (draw-fps 10 10))
          (k (end-drawing)))
      (f f)))))

(loop loop)

(close-window)
