(define Vector2 (ffi-struct "Vector2" (list
  (list "x" "f32")
  (list "y" "f32"))))

(define Vector3 (ffi-struct "Vector3" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "z" "f32"))))

(define Vector4 (ffi-struct "Vector4" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "z" "f32")
  (list "w" "f32"))))

(define Color (ffi-struct "Color" (list
  (list "r" "u8")
  (list "g" "u8")
  (list "b" "u8")
  (list "a" "u8"))))

(define Rectangle (ffi-struct "Rectangle" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "width" "f32")
  (list "height" "f32"))))

(define Image (ffi-struct "Image" (list
  (list "data" "ptr")
  (list "width" "i32")
  (list "height" "i32")
  (list "mipmaps" "i32")
  (list "format" "i32"))))

(define Texture (ffi-struct "Texture" (list
  (list "id" "u32")
  (list "width" "i32")
  (list "height" "i32")
  (list "mipmaps" "i32")
  (list "format" "i32"))))

(define Camera2D (ffi-struct "Camera2D" (list
  (list "offset_x" "f32")
  (list "offset_y" "f32")
  (list "target_x" "f32")
  (list "target_y" "f32")
  (list "rotation" "f32")
  (list "zoom" "f32"))))

(define Camera3D (ffi-struct "Camera3D" (list
  (list "position_x" "f32")
  (list "position_y" "f32")
  (list "position_z" "f32")
  (list "target_x" "f32")
  (list "target_y" "f32")
  (list "target_z" "f32")
  (list "up_x" "f32")
  (list "up_y" "f32")
  (list "up_z" "f32")
  (list "fovy" "f32")
  (list "projection" "i32"))))

(define Ray (ffi-struct "Ray" (list
  (list "position_x" "f32")
  (list "position_y" "f32")
  (list "position_z" "f32")
  (list "direction_x" "f32")
  (list "direction_y" "f32")
  (list "direction_z" "f32"))))

(define BoundingBox (ffi-struct "BoundingBox" (list
  (list "min_x" "f32")
  (list "min_y" "f32")
  (list "min_z" "f32")
  (list "max_x" "f32")
  (list "max_y" "f32")
  (list "max_z" "f32"))))

(define LIGHTGRAY (struct-new Color 200 200 200 255))
(define GRAY (struct-new Color 130 130 130 255))
(define DARKGRAY (struct-new Color 80 80 80 255))
(define YELLOW (struct-new Color 253 249 0 255))
(define GOLD (struct-new Color 255 203 0 255))
(define ORANGE (struct-new Color 255 161 0 255))
(define PINK (struct-new Color 255 109 194 255))
(define RED (struct-new Color 230 41 55 255))
(define MAROON (struct-new Color 190 33 55 255))
(define GREEN (struct-new Color 0 228 48 255))
(define LIME (struct-new Color 0 158 47 255))
(define DARKGREEN (struct-new Color 0 117 44 255))
(define SKYBLUE (struct-new Color 102 191 255 255))
(define BLUE (struct-new Color 0 121 241 255))
(define DARKBLUE (struct-new Color 0 82 172 255))
(define PURPLE (struct-new Color 200 122 255 255))
(define VIOLET (struct-new Color 135 60 190 255))
(define DARKPURPLE (struct-new Color 112 31 126 255))
(define BEIGE (struct-new Color 211 176 131 255))
(define BROWN (struct-new Color 127 106 79 255))
(define DARKBROWN (struct-new Color 76 63 47 255))
(define WHITE (struct-new Color 255 255 255 255))
(define BLACK (struct-new Color 0 0 0 255))
(define BLANK (struct-new Color 0 0 0 0))
(define MAGENTA (struct-new Color 255 0 255 255))
(define RAYWHITE (struct-new Color 245 245 245 255))

