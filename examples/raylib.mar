(define Vector2 (ffi-struct "Vector2" (list
  (list "x" "f32")
  (list "y" "f32"))))

(define Vector3 (ffi-struct "Vector3" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "z" "f32"))))

(define Vector4 (ffi-struct "Vector4" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "z" "f32")
  (list "w" "f32"))))

(define Color (ffi-struct "Color" (list
  (list "r" "u8")
  (list "g" "u8")
  (list "b" "u8")
  (list "a" "u8"))))

(define Rectangle (ffi-struct "Rectangle" (list
  (list "x" "f32")
  (list "y" "f32")
  (list "width" "f32")
  (list "height" "f32"))))

(define Image (ffi-struct "Image" (list
  (list "data" "ptr")
  (list "width" "i32")
  (list "height" "i32")
  (list "mipmaps" "i32")
  (list "format" "i32"))))

(define Texture (ffi-struct "Texture" (list
  (list "id" "u32")
  (list "width" "i32")
  (list "height" "i32")
  (list "mipmaps" "i32")
  (list "format" "i32"))))

(define Camera2D (ffi-struct "Camera2D" (list
  (list "offset_x" "f32")
  (list "offset_y" "f32")
  (list "target_x" "f32")
  (list "target_y" "f32")
  (list "rotation" "f32")
  (list "zoom" "f32"))))

(define Camera3D (ffi-struct "Camera3D" (list
  (list "position_x" "f32")
  (list "position_y" "f32")
  (list "position_z" "f32")
  (list "target_x" "f32")
  (list "target_y" "f32")
  (list "target_z" "f32")
  (list "up_x" "f32")
  (list "up_y" "f32")
  (list "up_z" "f32")
  (list "fovy" "f32")
  (list "projection" "i32"))))

(define Ray (ffi-struct "Ray" (list
  (list "position_x" "f32")
  (list "position_y" "f32")
  (list "position_z" "f32")
  (list "direction_x" "f32")
  (list "direction_y" "f32")
  (list "direction_z" "f32"))))

(define BoundingBox (ffi-struct "BoundingBox" (list
  (list "min_x" "f32")
  (list "min_y" "f32")
  (list "min_z" "f32")
  (list "max_x" "f32")
  (list "max_y" "f32")
  (list "max_z" "f32"))))

