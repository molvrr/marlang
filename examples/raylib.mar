(define make-vector2 (lambda (x y)
  (struct-new Vector2 x y)))

(define make-vector3 (lambda (x y z)
  (struct-new Vector3 x y z)))

(define make-color (lambda (r g b a)
  (struct-new Color r g b a)))

(define make-rect (lambda (x y w h)
  (struct-new Rectangle x y w h)))

(rl/InitWindow 800 600 "Marlang + Raylib")
(rl/SetTargetFPS 60)

(define loop (lambda (f)
  (when (rl/WindowShouldClose)
    (begin
      (rl/BeginDrawing)
      (rl/ClearBackground RAYWHITE)
      (rl/DrawText "Hello from Marlang + Raylib!" 150 200 40 DARKGRAY)
      (rl/DrawText "Press ESC to exit" 280 260 20 GRAY)
      (rl/DrawCircle 400 400 80.0 RED)
      (rl/DrawCircle 300 350 40.0 BLUE)
      (rl/DrawCircle 500 350 40.0 GREEN)
      (rl/DrawRectangle 50 50 100 60 ORANGE)
      (rl/DrawFPS 10 10)
      (rl/EndDrawing)
      (f f)))))

(loop loop)

(rl/CloseWindow)
