; Client Components with Effect Proxying — End-to-End Demo
;
; The component body uses standard Marlang effect syntax:
;   - Atom effects (atom-new, atom-read, atom-set) are declared in std:js
;   - Server effects (load-count, save-count, server-time) are declared here
;   - The type checker verifies arities, types, and effect declarations
;   - The same body compiles to a JS generator for client-side execution
;
; At runtime:
;   - Atom effects are handled locally in the browser (instant)
;   - Server effects are proxied over WebSocket (round-trip)
;
; Run:
;   cargo run -p marlang-cli --release -- run examples/client-counter.mar
;   Open http://127.0.0.1:3000

(import "std:web" as w)
(import "std:io" as io)
(import "std:js" as js)

; =========================================================================
; Server effect declarations — type-checked, proxied at runtime
; =========================================================================

(effect Server
  (load-count  (-> Unit String))
  (save-count  (-> String String))
  (server-time (-> Unit String)))

; =========================================================================
; Shared functions — compiled to both Marlang and JS
; =========================================================================

(js/define-shared pluralize (n word)
  (if (= n 1) (string-append "1 " word)
    (string-append (show n) (string-append " " (string-append word "s")))))

; Marlang str-cat for server-side rendering
(define str-cat (lambda (parts)
  (match parts
    (Nil "")
    ((Cons h Nil) h)
    ((Cons h rest) (string-append h (str-cat rest))))))

; JS str-cat for client-side (native arrays)
(js/register-shared-js "const str_cat = (parts) => parts.join('')")

; parse-int: Marlang version wraps string->int, JS version uses parseInt
(define parse-int (lambda (s) (string->int s)))
(js/register-shared-js "const parse_int = (s) => parseInt(s, 10) || 0")

; =========================================================================
; Client component — standard Marlang effect syntax, type-checked
;
; perform atom-new   → Atom effect (declared in std:js)
; perform load-count → Server effect (declared above)
;
; The type checker verifies all effects are declared and arities are correct.
; At runtime: Atom effects run locally, Server effects proxy over WebSocket.
; =========================================================================

(js/define-client app (unused)
  (let ((ref (perform atom-new 0))
        (loaded-ref (perform atom-new #f))
        (loaded (perform atom-read loaded-ref)))
    (begin
      ; Load from server only on first render
      (if (not loaded)
        (let ((server-count (perform load-count)))
          (begin
            (perform atom-set ref (parse-int server-count))
            (perform atom-set loaded-ref #t)
            nil))
        nil)
      ; Render
      (let ((count (perform atom-read ref))
            (msg-ref (perform atom-new ""))
            (msg (perform atom-read msg-ref)))
        (str-cat (list
          "<div class=\"app\"><h2>Counter</h2><div class=\"counter\"><span class=\"count\">"
          (pluralize count "click")
          "</span> <button onclick=\"marlang.updateAtom("
          (show ref)
          ", function(n){return n+1})\">+1</button> <button onclick=\"marlang.updateAtom("
          (show ref)
          ", function(n){return n-1})\">-1</button></div>"
          "<h2>Server Effects</h2><div class=\"server\">"
          "<button onclick=\"marlang.action(function*(){var c=yield{effect:'atom_read',args:["
          (show ref)
          "]};var r=yield{effect:'save_count',args:[c]};marlang.updateAtom("
          (show msg-ref)
          ",function(){return r})})\">Save Count to Server</button> "
          "<button onclick=\"marlang.action(function*(){var t=yield{effect:'server_time',args:[]};marlang.updateAtom("
          (show msg-ref)
          ",function(){return t})})\">Get Server Time</button>"
          "<div class=\"message\">"
          (if (string= msg "") "Count loaded from server" msg)
          "</div></div></div>"))))))

; =========================================================================
; Page layout
; =========================================================================

(define page-style "
  * { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 2rem auto; padding: 0 1rem; background: #1a1a2e; color: #e0e0e0; }
  h1 { color: #7b68ee; margin-bottom: 0.5rem; }
  h2 { color: #aaa; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 1.5rem; }
  .counter { font-size: 1.5rem; padding: 1rem; background: #16213e; border-radius: 8px; text-align: center; }
  .count { color: #4caf50; font-weight: bold; }
  .server { padding: 1rem; background: #16213e; border-radius: 8px; }
  .message { margin-top: 0.75rem; padding: 0.75rem; background: #0f3460; border-radius: 4px; color: #7ec8e3; min-height: 2.5rem; }
  button { padding: 0.4rem 1rem; font-size: 1rem; background: #7b68ee; color: white; border: none; border-radius: 4px; cursor: pointer; margin: 0.2rem; }
  button:hover { background: #6a5acd; }
  button:active { background: #5a4abf; }
  .info { color: #666; font-size: 0.85rem; margin-top: 2rem; line-height: 1.6; }
  .tag { display: inline-block; padding: 0.1rem 0.4rem; border-radius: 3px; font-size: 0.8rem; font-weight: bold; }
  .tag-local { background: #1b5e20; color: #a5d6a7; }
  .tag-server { background: #4a148c; color: #ce93d8; }
")

(define render-page (lambda ()
  (w/html (list (MkPair "lang" "en"))
    (string-append
      (w/head (string-append
        (w/title "Client + Server Effects")
        (w/meta (list (MkPair "charset" "utf-8")))
        (w/style page-style)
        (js/client-bundle-script)))
      (w/body (list)
        (string-append
          (w/h1 (list) "Client + Server Effects")
          (app 0)
          (w/p (list (MkPair "class" "info"))
            (string-append
              "<span class=\"tag tag-local\">LOCAL</span> +1 / -1 use Atom effects — instant, no server. "
              "<span class=\"tag tag-server\">SERVER</span> Count loaded from server on first render. Save and Get Time proxy over WebSocket."))))))))

(define handle-home (lambda () (w/ok (render-page))))
(define routes (list (w/GET "/" handle-home)))

; =========================================================================
; Server state + effect handlers
; =========================================================================

(define server-count (w/cell-new 0))

; Server-side effect dispatch — standard Marlang match function.
; Effect names and args arrive as strings from the client.
(define handle-effects (lambda (name args)
  (match name
    ("load_count"
      (let ((n (w/cell-get server-count)))
        (begin
          (io/println (string-append "Client loaded count: " (show n)))
          (show n))))
    ("save_count"
      (let ((n (match args ((Cons s _) s) (_ "0"))))
        (begin
          (w/cell-set server-count (string->int n))
          (io/println (string-append "Client saved count: " n))
          (string-append "Saved! Count is now " n))))
    ("server_time"
      (begin
        (io/println "Client requested server time")
        "Server time: just now"))
    (_ (perform throw (string-append "Unknown effect: " name))))))

(w/run-live-with-effects! 3000 routes handle-effects)
