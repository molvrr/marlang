; Frontend test server — exercises live updates + client components
; No PostgreSQL required. Uses in-memory state.
;
; Run:  cargo run -p marlang-cli --release -- run examples/test-frontend.mar
; Open: http://127.0.0.1:3001
; Tests run automatically in the browser and report pass/fail.

(import "std:web" as w)
(import "std:io" as io)
(import "std:js" as js)

; =========================================================================
; Server effects for client component
; =========================================================================

(effect Server
  (load-time  (-> Unit String))
  (save-note  (-> String String)))

; =========================================================================
; Shared functions
; =========================================================================

(js/define-shared double (n) (* n 2))

(define str-cat (lambda (parts)
  (match parts
    (Nil "")
    ((Cons h Nil) h)
    ((Cons h rest) (string-append h (str-cat rest))))))
(js/register-shared-js "const str_cat = (parts) => parts.join('')")

; =========================================================================
; In-memory live counter (Phase 2 — server-rendered)
; =========================================================================

(define live-count (w/live 0 (lambda (n) (show n))))

; =========================================================================
; Client component counter (Phase 4 — client-side atoms + server effects)
; =========================================================================

(js/define-client client-counter (initial) (js/Atom Server)
  (let ((ref (perform atom-new initial))
        (msg-ref (perform atom-new "ready"))
        (count (perform atom-read ref))
        (msg (perform atom-read msg-ref)))
    (str-cat (list
      "<div id=\"cc-value\" data-count=\"" (show count) "\">"
      (show count)
      "</div>"
      "<button id=\"cc-inc\" onclick=\"marlang.updateAtom("
      (show ref) ",function(n){return n+1})\">cc+</button>"
      "<button id=\"cc-dec\" onclick=\"marlang.updateAtom("
      (show ref) ",function(n){return n-1})\">cc-</button>"
      "<button id=\"cc-time\" onclick=\"marlang.action(function*(){"
        "var t=yield{effect:'load_time',args:[]};"
        "marlang.updateAtom(" (show msg-ref) ",function(){return t})"
      "})\">time</button>"
      "<div id=\"cc-msg\">" msg "</div>"))))

; =========================================================================
; Handlers
; =========================================================================

(define handle-increment (lambda ()
  (begin (w/live-update live-count (lambda (n) (+ n 1))) (w/ok ""))))

(define handle-decrement (lambda ()
  (begin (w/live-update live-count (lambda (n) (- n 1))) (w/ok ""))))

(define handle-reset (lambda ()
  (begin (w/live-set live-count 0) (w/ok ""))))

; =========================================================================
; Test script — runs automatically, checks DOM state
; =========================================================================

(define test-js "
(function() {
  const results = [];
  let passed = 0, failed = 0;

  function assert(name, condition, msg) {
    if (condition) {
      results.push({name, ok: true});
      passed++;
    } else {
      results.push({name, ok: false, msg: msg || 'assertion failed'});
      failed++;
    }
  }

  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  function getCC() {
    const el = document.getElementById('cc-value');
    return el ? parseInt(el.getAttribute('data-count'), 10) : null;
  }

  function getLive() {
    const el = document.getElementById('live-val');
    if (!el) return null;
    // The live-el div is nested inside our wrapper
    const inner = el.querySelector('.counter-display');
    return inner ? parseInt(inner.textContent.trim(), 10) : parseInt(el.textContent.trim(), 10);
  }

  function renderResults() {
    const el = document.getElementById('test-results');
    if (!el) return;
    el.innerHTML = results.map(r =>
      '<div style=\"padding:4px;color:' + (r.ok ? '#2e7d32' : '#c62828') + '\">' +
      (r.ok ? '✓' : '✗') + ' ' + r.name +
      (r.msg ? ' — ' + r.msg : '') +
      '</div>'
    ).join('') +
    '<div style=\"margin-top:8px;font-weight:bold;color:' +
    (failed > 0 ? '#c62828' : '#2e7d32') + '\">' +
    passed + ' passed, ' + failed + ' failed</div>';
  }

  async function runTests() {
    // Wait for client component to mount
    await sleep(1500);

    // --- Test 1: Client counter renders ---
    const cc1 = getCC();
    assert('client counter renders', cc1 !== null, 'cc-value not found');
    assert('client counter starts at 0', cc1 === 0, 'got ' + cc1);

    // --- Test 2: Live counter renders ---
    const lc1 = getLive();
    assert('live counter renders', lc1 !== null, 'live-val not found');
    assert('live counter starts at 0', lc1 === 0, 'got ' + lc1);

    // --- Test 3: Client counter increment (local atom, instant) ---
    document.getElementById('cc-inc').click();
    await sleep(300);
    const cc2 = getCC();
    assert('client counter increments', cc2 === 1, 'expected 1, got ' + cc2);

    // --- Test 4: Live counter should NOT have changed ---
    const lc2 = getLive();
    assert('live counter unchanged after cc+', lc2 === 0, 'expected 0, got ' + lc2);

    // --- Test 5: Live counter increment (server POST) ---
    post('/api/increment');
    await sleep(800);
    const lc3 = getLive();
    assert('live counter increments via POST', lc3 === 1, 'expected 1, got ' + lc3);

    // --- Test 6: Client counter should NOT have changed ---
    const cc3 = getCC();
    assert('client counter unchanged after live+', cc3 === 1, 'expected 1, got ' + cc3);

    // --- Test 7: Multiple live increments ---
    post('/api/increment');
    post('/api/increment');
    await sleep(1000);
    const lc4 = getLive();
    assert('live counter at 3 after 2 more', lc4 === 3, 'expected 3, got ' + lc4);

    // --- Test 8: Client counter still independent ---
    const cc4 = getCC();
    assert('client counter still 1', cc4 === 1, 'expected 1, got ' + cc4);

    // --- Test 9: Client counter decrement ---
    document.getElementById('cc-dec').click();
    await sleep(300);
    const cc5 = getCC();
    assert('client counter decrements to 0', cc5 === 0, 'expected 0, got ' + cc5);

    // --- Test 10: define-shared works ---
    assert('define-shared double exists', typeof double === 'function', 'double not found');
    assert('define-shared double(21)=42', double(21) === 42, 'got ' + double(21));

    // --- Test 11: Live counter reset ---
    post('/api/reset');
    await sleep(800);
    const lc5 = getLive();
    assert('live counter resets to 0', lc5 === 0, 'expected 0, got ' + lc5);

    // --- Test 12: Client counter still 0 (not affected by reset) ---
    const cc6 = getCC();
    assert('client counter still 0 after reset', cc6 === 0, 'expected 0, got ' + cc6);

    renderResults();
    console.log(passed + ' passed, ' + failed + ' failed');
  }

  document.addEventListener('DOMContentLoaded', () => setTimeout(runTests, 500));
})();
")

; =========================================================================
; Page layout
; =========================================================================

(define css "
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; max-width: 640px; margin: 0 auto; padding: 2rem; }
  h1 { margin-bottom: 1rem; }
  h2 { margin-bottom: 0.5rem; font-size: 0.9rem; text-transform: uppercase; color: #666; }
  .card { background: #f8f8f8; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
  .counter-display { font-size: 2rem; font-weight: bold; text-align: center; padding: 0.5rem; }
  .buttons { display: flex; gap: 0.5rem; justify-content: center; }
  .buttons button { padding: 0.4rem 1rem; border: 1px solid #ccc; border-radius: 4px; background: white; cursor: pointer; }
  #test-results { background: #fafafa; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-top: 1.5rem; font-family: monospace; font-size: 0.85rem; }
")

(define handle-home (lambda ()
  (w/ok
    (w/html (list (MkPair "lang" "en"))
      (string-append
        (w/head (string-append
          (w/title "Frontend Tests")
          (w/meta (list (MkPair "charset" "utf-8")))
          (w/style css)
          (w/live-scripts)
          (js/client-bundle-script)
          (w/script (list) test-js)))
        (w/body (list)
          (string-append
            (w/h1 (list) "Frontend Tests")

            ; Live counter (server-rendered)
            (w/div (list (MkPair "class" "card"))
              (string-append
                (w/h2 (list) "Live Counter (server-rendered)")
                (w/div (list (MkPair "id" "live-val"))
                  (w/live-el "div" live-count
                    (list (MkPair "class" "counter-display"))))
                (w/div (list (MkPair "class" "buttons"))
                  (string-append
                    (w/button (list (MkPair "id" "live-dec")
                                   (MkPair "onclick" "post('/api/decrement')")) "-")
                    (w/button (list (MkPair "id" "live-inc")
                                   (MkPair "onclick" "post('/api/increment')")) "+")
                    (w/button (list (MkPair "id" "live-reset")
                                   (MkPair "onclick" "post('/api/reset')")) "Reset")))))

            ; Client counter (client component)
            (w/div (list (MkPair "class" "card"))
              (string-append
                (w/h2 (list) "Client Counter (client component)")
                (client-counter 0)))

            ; Test results
            (w/div (list (MkPair "id" "test-results")) "Tests running..."))))))))

; =========================================================================
; Effect handler
; =========================================================================

(define handle-effects (lambda (name args)
  (match name
    ("load_time" "Server time: just now")
    ("save_note"
      (let ((note (match args ((Cons s _) s) (_ ""))))
        (string-append "Saved: " note)))
    (_ (perform throw (string-append "Unknown effect: " name))))))

; =========================================================================
; Routes
; =========================================================================

(define routes (list
  (w/GET  "/"              handle-home)
  (w/POST "/api/increment" handle-increment)
  (w/POST "/api/decrement" handle-decrement)
  (w/POST "/api/reset"     handle-reset)))

(io/println "Starting test server...")
(w/run-live-with-effects! 3001 routes handle-effects)
