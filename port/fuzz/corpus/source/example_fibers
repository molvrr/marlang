; Green Threads (Fibers) Example
;
; Fibers are lightweight, cooperatively-scheduled threads.
; All concurrency operations are algebraic effects handled
; by the run-fibers scheduler.
;
; Run with: cargo run -p marlang-cli -- run examples/fibers.mar

(import "std:concurrent" as conc)
(import "std:io" as io)

; === Example 1: Spawn and Yield ===
;
; Fibers interleave execution at yield points

(run-fibers (lambda ()
  (conc/spawn (lambda ()
    (io/println "B1")
    (conc/yield)
    (io/println "B2")
    (conc/yield)
    (io/println "B3")))

  (io/println "A1")
  (conc/yield)
  (io/println "A2")
  (conc/yield)
  (io/println "A3")))

; Output (interleaved):
;   A1
;   B1
;   A2
;   B2
;   A3
;   B3
