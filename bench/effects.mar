; Effect-heavy benchmark: many perform/resume cycles
; Tests both tail-resumptive (counter) and continuation-capturing (collect) effects

(effect Tick
  (tick (-> Unit Int)))

; Tail-resumptive handler: tick returns a constant
; 100,000 iterations to get measurable time
(define loop-tick (lambda (n acc)
  (if (= n 0)
    acc
    (loop-tick (- n 1) (+ acc (perform tick))))))

(handle
  (loop-tick 100000 0)
  ((tick k) -> (resume k 1)))
